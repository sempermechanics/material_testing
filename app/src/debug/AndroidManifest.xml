<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only: exported seed so adb can open the result viewer on an emulator. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- HotPathMicroBenchmark runs in :app's androidTest, so the app under test is this
         one, and BenchmarkRule grants it WRITE_EXTERNAL_STORAGE on every API level. The
         main manifest no longer requests it (minSdk 30: scoped storage gives it no
         access), and without a declaration the grant throws a SecurityException before
         any benchmark runs. Debug builds only. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application>
        <activity
            android:name="com.sempermechanics.semper.debug.DebugViewerSeedActivity"
            android:exported="true" />
    </application>
</manifest>
