<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn over the magnified crop, not behind it: the loupe sits on top of a
     live preview, so without an edge it reads as part of the picture rather
     than as a window into it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="2dp"
        android:color="@color/sky_bright" />
    <solid android:color="@android:color/transparent" />
</shape>
