<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass circle: soft fill + rim highlight (wireframe ghost). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/viewer_glass_fill" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/viewer_glass_stroke" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
