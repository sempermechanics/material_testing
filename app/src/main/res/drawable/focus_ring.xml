<?xml version="1.0" encoding="utf-8"?>
<!--
  The focus point, drawn over the live preview.

  Two rings rather than one: the preview is whatever the specimen happens to
  look like, and a single-colour marker disappears against a pattern of the
  same tone. A dark ring outside a bright one stays visible on both.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="3dp"
                android:color="#B3000000" />
        </shape>
    </item>
    <item android:inset="2dp">
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="@color/sky_bright" />
        </shape>
    </item>
</layer-list>
