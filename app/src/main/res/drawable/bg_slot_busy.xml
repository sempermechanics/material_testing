<?xml version="1.0" encoding="utf-8"?>
<!-- A wizard slot while its pick is read: opaque, so it covers the dropzone or the
     card under it, with the same hairline rim as the filled card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="12dp" />
    <stroke android:width="1dp" android:color="@color/viewer_glass_stroke" />
    <solid android:color="@color/viewer_canvas" />
</shape>
