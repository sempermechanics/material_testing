<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass panel: soft fill + rim highlight, rounded-rect sibling of
     bg_chrome_ghost.xml (which uses ovals for the round chrome icons). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/viewer_glass_fill" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/viewer_glass_stroke" />
            <solid android:color="@android:color/transparent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
