<?xml version="1.0" encoding="utf-8"?>
<!-- Chip-style toggle: sky-blue fill when checked, translucent when off -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sky_container" />
            <stroke android:width="1.5dp" android:color="@color/sky_primary" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/viewer_chip_off" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/surface_outline" />
        </shape>
    </item>
</selector>
