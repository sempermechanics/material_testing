<?xml version="1.0" encoding="utf-8"?>
<!-- The picked sweep frame large over the dimmed page (SweepFramePicker).
     A tap anywhere closes it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/image_overlay_scrim"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_16">

    <ImageView
        android:id="@+id/imgSweepFrameOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/tvSweepFrameOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:textAppearance="@style/TextAppearance.Semper.Numeric"
        android:textColor="@android:color/white"
        tools:text="steel_24.png · Frame 2 of 3" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:alpha="0.7"
        android:text="@string/sweep_frame_overlay_close"
        android:textAppearance="@style/TextAppearance.Semper.Caption"
        android:textColor="@android:color/white" />
</LinearLayout>
