<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame,TooDeepLayout,DisableBaselineAlignment,UselessParent">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/viewer_canvas">

    <!-- ===================== App bar ===================== -->
    <!-- Same minimal-chrome vocabulary as the result viewer and result
         lattice: viewer_canvas/viewer_chrome_* tokens, zero elevation. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/viewer_canvas"
        app:titleTextColor="@color/viewer_chrome_text"
        app:subtitleTextColor="@color/viewer_chrome_muted"
        app:navigationIconTint="@color/viewer_chrome_text"
        app:titleCentered="false"
        android:elevation="0dp">

        <!-- One dot per wizard page; the toolbar title names the page. -->
        <TextView
            android:id="@+id/tvStepDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/space_16"
            android:letterSpacing="0.1"
            android:textSize="12sp"
            tools:text="● ● ○" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- ===================== Pages ===================== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============ PAGE 1: image loading ============ -->
        <ScrollView
            android:id="@+id/scrollStepImages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/contentColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Reference slot: dropzone when empty, summary card when filled -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/refDropzone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_dropzone_dashed"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@string/reference_image"
                            android:src="@drawable/ic_add"
                            app:tint="@color/viewer_chrome_muted" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/reference_image"
                            android:textColor="@color/viewer_chrome_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ref_formats_hint"
                            android:textColor="@color/viewer_chrome_muted"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/refCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:strokeColor="@color/viewer_glass_stroke">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/imgRefThumb"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:background="@color/viewer_canvas"
                                android:contentDescription="@string/reference_image_preview"
                                android:scaleType="centerCrop" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvRefName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="middle"
                                    android:maxLines="1"
                                    android:textColor="@color/viewer_chrome_text"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvRefMeta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/viewer_chrome_muted"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRefChange"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/action_change" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Over the dropzone or card while a pick is read (ReferenceSlotBusy):
                         a skeleton thumbnail while an image decodes, a spinner while a
                         video's metadata is read. Shown only past 300 ms. -->
                    <LinearLayout
                        android:id="@+id/refBusy"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_slot_busy"
                        android:gravity="center_vertical"
                        android:minHeight="46dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <View
                            android:id="@+id/refBusySkeleton"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_skeleton_thumb" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/refBusySpinner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@color/sky_primary"
                            app:indicatorSize="18dp"
                            app:trackThickness="2dp" />

                        <TextView
                            android:id="@+id/tvRefBusy"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/viewer_chrome_muted"
                            android:textSize="12sp"
                            tools:text="Decoding RAW · 24 MP" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Deformed frames slot -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:id="@+id/defDropzone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_dropzone_dashed"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@string/deformed_frames"
                            android:src="@drawable/ic_add"
                            app:tint="@color/viewer_chrome_muted" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/deformed_frames"
                            android:textColor="@color/viewer_chrome_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDefDropHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/viewer_chrome_muted"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/defCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:strokeColor="@color/viewer_glass_stroke">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:orientation="vertical"
                            android:paddingBottom="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/imgDefIcon"
                                    android:layout_width="46dp"
                                    android:layout_height="46dp"
                                    android:background="@color/viewer_canvas"
                                    android:contentDescription="@string/deformed_frames"
                                    android:padding="11dp"
                                    android:src="@drawable/ic_photos_share"
                                    app:tint="@color/viewer_chrome_muted" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvDefName"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/viewer_chrome_text"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvDefMeta"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="middle"
                                        android:maxLines="1"
                                        android:textColor="@color/viewer_chrome_muted"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnDefChange"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/action_change" />

                                <ImageButton
                                    android:id="@+id/btnFrameOrderSort"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/frame_order_label"
                                    android:padding="8dp"
                                    android:src="@drawable/ic_sort"
                                    android:visibility="gone"
                                    app:tint="@color/viewer_chrome_muted" />
                            </LinearLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvFrameOrder"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:orientation="horizontal"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <!-- Machine load card (tensile / compression only): inflated by
                     the Activity when the test takes a load per frame. -->
                <ViewStub
                    android:id="@+id/stubLoadCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inflatedId="@+id/loadCard"
                    android:layout="@layout/wizard_load_card" />

                <!-- Inline lossy-format accuracy warning (non-blocking) -->
                <include
                    android:id="@+id/formatWarnRow"
                    layout="@layout/view_warn_chip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <!-- Inline speckle-quality warning: the SSSIG measurement could
                     not reach the accuracy target even at the largest subset. -->
                <include
                    android:id="@+id/lowTextureWarnRow"
                    layout="@layout/view_warn_chip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <!-- Inline speckle-size warning: the measured dot diameter
                     sits outside the iDICs 3-9 px band. A different question
                     from the row above it, which is about contrast rather than
                     scale. Scale belongs on this step because the only fix is
                     a different image; the subset-span message, whose fix is
                     the step 2 slider, lives on step 2 instead. -->
                <include
                    android:id="@+id/speckleWarnRow"
                    layout="@layout/view_warn_chip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvNextReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="@color/viewer_chrome_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ============ PAGE 2: settings (ViewStub; same view IDs) ============ -->
        <ViewStub
            android:id="@+id/stubStepSettings"
            android:layout="@layout/wizard_step_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- ============ PAGE 3: parameter sweep (ViewStub; same view IDs) ============ -->
        <ViewStub
            android:id="@+id/stubStepSweep"
            android:layout="@layout/wizard_step_sweep"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- ===================== Bottom wizard navigation ===================== -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:background="@color/viewer_canvas"
        android:elevation="0dp"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Semper.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="@string/back"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalculateFullField"
            style="@style/Widget.Semper.Button.Cta"
            android:maxLines="1"
            app:autoSizeMaxTextSize="16sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeTextType="uniform"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="@string/run_analysis"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRunSweep"
            style="@style/Widget.Semper.Button.Cta"
            android:maxLines="1"
            app:autoSizeMaxTextSize="16sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeTextType="uniform"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="@string/run_analysis"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            style="@style/Widget.Semper.Button.Cta"
            android:maxLines="1"
            app:autoSizeMaxTextSize="16sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeTextType="uniform"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="@string/action_next" />
    </LinearLayout>
  </LinearLayout>

    <!-- ===================== Compute progress overlay ===================== -->
    <!-- Full-screen scrim + centered card; blocks touches while the native
         engine runs. Driven by the ProgressCallback in checkReady/compute. -->
    <FrameLayout
        android:id="@+id/computeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000814"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/space_24"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_24">

                <!-- Header: what is running ("Frame 4 of 5", "Analysis 6 of 9",
                     an import's title, the end state) and the whole job's percent. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRunHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/initializing_engine"
                        android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                        tools:text="Frame 4 of 5" />

                    <TextView
                        android:id="@+id/tvRunPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/sky_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="79.0%" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRunEta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/eta_estimating"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- An import's or a video extraction's progress. -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/overlayBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:max="1000"
                    android:visibility="gone"
                    app:indicatorColor="@color/sky_primary"
                    app:trackColor="@color/sky_container"
                    app:trackThickness="6dp"
                    app:trackCornerRadius="3dp" />

                <!-- A batch run's convergence per frame. -->
                <com.sempermechanics.semper.ui.analysis.run.ConvergenceBinsView
                    android:id="@+id/runBins"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="@dimen/space_16" />

                <LinearLayout
                    android:id="@+id/runSweepGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.sempermechanics.semper.ui.analysis.sweep.SweepLatticeView
                        android:id="@+id/runSweepLattice"
                        android:layout_width="match_parent"
                        android:layout_height="136dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/run_sweep_legend"
                        android:textAppearance="@style/TextAppearance.Semper.Caption" />
                </LinearLayout>

                <!-- An import's status, or the combination a sweep is solving. -->
                <TextView
                    android:id="@+id/overlayStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvRunStrikeWarn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textColor="@color/semantic_warning"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Frame 24: 41% converged. One more low frame stops the run."
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRunCancel"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="@string/action_cancel"
                    android:textColor="@color/semantic_danger" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</FrameLayout>
