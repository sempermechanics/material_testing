<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_muted">

    <!-- ===================== App bar ===================== -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/surface"
        app:titleTextColor="@color/text_primary"
        app:subtitleTextColor="@color/text_secondary"
        app:navigationIconTint="@color/text_primary"
        app:titleCentered="false"
        android:elevation="2dp">
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- ===================== Pages ===================== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============ PAGE 1: image loading ============ -->
        <ScrollView
            android:id="@+id/scrollStepImages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/contentColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Reference slot: dropzone when empty, summary card when filled -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/refDropzone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_dropzone_dashed"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@string/reference_image"
                            android:src="@drawable/ic_add"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/reference_image"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ref_formats_hint"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/refCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivRefThumb"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:background="@color/surface_muted"
                                android:contentDescription="@string/reference_image_preview"
                                android:scaleType="centerCrop" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvRefName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="middle"
                                    android:maxLines="1"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvRefMeta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRefChange"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/action_change" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <!-- Deformed frames slot -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:id="@+id/defDropzone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_dropzone_dashed"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@string/deformed_frames"
                            android:src="@drawable/ic_add"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/deformed_frames"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDefDropHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/defCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivDefIcon"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:background="@color/surface_muted"
                                android:contentDescription="@string/deformed_frames"
                                android:padding="11dp"
                                android:src="@drawable/ic_photos_share"
                                app:tint="@color/text_secondary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvDefName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDefMeta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="middle"
                                    android:maxLines="1"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDefChange"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/action_change" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <!-- Inline JPEG accuracy warning (non-blocking) -->
                <LinearLayout
                    android:id="@+id/jpegWarnRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_warn_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/info"
                        android:src="@android:drawable/stat_sys_warning"
                        app:tint="@color/semantic_warning" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/jpeg_warning_inline"
                        android:textColor="@color/semantic_warning"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNextReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ============ PAGE 2: settings + run ============ -->
        <ScrollView
            android:id="@+id/scrollStepSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/settingsColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Inputs summary -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivInputsThumb"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@color/surface_muted"
                            android:contentDescription="@string/reference_image_preview"
                            android:scaleType="centerCrop" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvInputsTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="middle"
                                android:maxLines="1"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvInputsMeta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Region of interest -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@string/region_of_interest"
                                android:src="@drawable/ic_tune"
                                app:tint="@color/text_secondary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/region_of_interest"
                                    android:textAppearance="@style/TextAppearance.IndicVision.SectionHeader" />

                                <TextView
                                    android:id="@+id/tvInstruction"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDefineRoi"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/action_edit" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFullImage"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-4dp"
                            android:text="@string/use_full_image" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card: Analysis parameters (dedicated settings page) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/advancedParamsHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="?attr/selectableItemBackground"
                            android:paddingBottom="4dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_tune"
                                android:contentDescription="@string/parameters" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/advanced_parameters"
                                    android:textAppearance="@style/TextAppearance.IndicVision.SectionHeader" />

                                <TextView
                                    android:id="@+id/tvAdvancedSummary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/ivAdvancedChevron"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@string/advanced_parameters"
                                android:src="@android:drawable/arrow_down_float"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/advancedParamsBody"
                            android:orientation="vertical"
                            android:paddingTop="8dp"
                            android:visibility="gone">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginBottom="12dp"
                                android:background="@color/surface_outline" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/subset_size"
                                    android:textColor="@color/text_primary"
                                    android:textStyle="bold" />

                                <ImageButton
                                    android:id="@+id/btnSubsetInfo"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="6dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/info"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_info_min"
                                    app:tint="@color/text_secondary" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="1dp"
                                    android:layout_weight="1" />
                                <EditText
                                    android:id="@+id/tvSubsetValue"
                                    android:layout_width="52dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:hint="@string/subset_size"
                                    android:imeOptions="actionDone"
                                    android:importantForAutofill="no"
                                    android:inputType="number"
                                    android:maxLength="3"
                                    android:paddingTop="0dp"
                                    android:paddingBottom="0dp"
                                    android:text="@string/label_41"
                                    android:textColor="@color/sky_primary"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="@string/scale_unit_px"
                                    android:textColor="@color/sky_primary"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <com.google.android.material.slider.Slider
                                android:id="@+id/etSubsetSize"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:valueFrom="15"
                                android:valueTo="101"
                                android:stepSize="2"
                                android:value="41" />

                            <TextView
                                android:id="@+id/tvSubsetHint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:visibility="gone"
                                tools:text="Suggested 27 px from the speckle pattern (SSSIG criterion)" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="4dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/step_size_density"
                                    android:textColor="@color/text_primary"
                                    android:textStyle="bold" />

                                <ImageButton
                                    android:id="@+id/btnStepInfo"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="6dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/info"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_info_min"
                                    app:tint="@color/text_secondary" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="1dp"
                                    android:layout_weight="1" />
                                <EditText
                                    android:id="@+id/tvStepValue"
                                    android:layout_width="52dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:hint="@string/step_size_density"
                                    android:imeOptions="actionDone"
                                    android:importantForAutofill="no"
                                    android:inputType="number"
                                    android:maxLength="3"
                                    android:paddingTop="0dp"
                                    android:paddingBottom="0dp"
                                    android:text="@string/label_5"
                                    android:textColor="@color/sky_primary"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="@string/scale_unit_px"
                                    android:textColor="@color/sky_primary"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <com.google.android.material.slider.Slider
                                android:id="@+id/etStepSize"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:valueFrom="1"
                                android:valueTo="30"
                                android:stepSize="1"
                                android:value="5" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="4dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/strain_window"
                                    android:textColor="@color/text_primary"
                                    android:textStyle="bold" />

                                <ImageButton
                                    android:id="@+id/btnStrainInfo"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="6dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/info"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_info_min"
                                    app:tint="@color/text_secondary" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="1dp"
                                    android:layout_weight="1" />
                                <EditText
                                    android:id="@+id/tvStrainValue"
                                    android:layout_width="52dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:hint="@string/strain_window"
                                    android:imeOptions="actionDone"
                                    android:importantForAutofill="no"
                                    android:inputType="number"
                                    android:maxLength="3"
                                    android:paddingTop="0dp"
                                    android:paddingBottom="0dp"
                                    android:text="@string/label_15"
                                    android:textColor="@color/sky_primary"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="@string/scale_unit_px"
                                    android:textColor="@color/sky_primary"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <com.google.android.material.slider.Slider
                                android:id="@+id/etStrainWindow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:valueFrom="5"
                                android:valueTo="51"
                                android:stepSize="2"
                                android:value="15" />



                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="@string/sub_pixel_interpolation_kernel"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/rgInterpolator"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                app:singleSelection="true"
                                app:selectionRequired="true"
                                app:checkedButton="@+id/rbBicubic">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/rbBicubic"
                                    style="@style/Widget.IndicVision.SegmentedButton"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_4_4_bicubic" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/rbKeys"
                                    style="@style/Widget.IndicVision.SegmentedButton"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_6_6_keys" />
                            </com.google.android.material.button.MaterialButtonToggleGroup>
                            <com.google.android.material.chip.Chip
                                android:id="@+id/btnAdvancedReset"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="10dp"
                                android:text="@string/action_reset"
                                android:textColor="@color/sky_primary"
                                app:chipBackgroundColor="@color/sky_container"
                                app:chipStrokeColor="@color/surface_outline"
                                app:chipStrokeWidth="1dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Compute + results -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalculateFullField"
                    style="@style/Widget.IndicVision.Button.Cta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/run_analysis"
                    android:enabled="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="14dp"
                    android:gravity="center">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/pbAnalysis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:trackColor="@color/sky_container"
                        app:indicatorColor="@color/sky_primary"
                        app:trackCornerRadius="4dp"
                        android:max="100" />

                    <TextView
                        android:id="@+id/tvTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/elapsed_time_0s"
                        android:visibility="gone"
                        android:textColor="@color/text_secondary"
                        android:textStyle="italic" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStaticResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/result"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:textAlignment="center"
                    android:layout_marginTop="12dp"
                    android:paddingBottom="20dp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- ===================== Bottom wizard navigation ===================== -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:elevation="10dp"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.IndicVision.Button.Outlined"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="@string/back"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/next_settings"
            android:enabled="false" />
    </LinearLayout>
  </LinearLayout>

    <!-- ===================== Compute progress overlay ===================== -->
    <!-- Full-screen scrim + centered card; blocks touches while the native
         engine runs. Driven by the ProgressCallback in checkReady/compute. -->
    <FrameLayout
        android:id="@+id/computeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000814"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">

                <TextView
                    android:id="@+id/overlayTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/computing_strain_field"
                    android:textAppearance="@style/TextAppearance.IndicVision.SectionHeader" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/overlayProgress"
                        android:layout_width="132dp"
                        android:layout_height="132dp"
                        android:layout_gravity="center"
                        app:indicatorColor="@color/sky_primary"
                        app:trackColor="@color/sky_container"
                        app:indicatorSize="132dp"
                        app:trackThickness="10dp"
                        app:indicatorInset="0dp"
                        android:max="100"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/overlayPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/label_0"
                        android:textColor="@color/sky_primary"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/overlayStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/initializing_engine"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/overlayElapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/elapsed_0s"
                    android:textAppearance="@style/TextAppearance.IndicVision.Caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@color/surface_muted"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/run_points_solved"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvRunPoints"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_0"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@color/surface_muted"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/run_convergence"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvRunConvergence"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_0"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRunCancel"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/action_cancel"
                    android:textColor="@color/semantic_danger" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="@string/please_keep_the_app_open"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</FrameLayout>
