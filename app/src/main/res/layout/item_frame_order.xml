<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="72dp"
    android:layout_height="72dp"
    android:layout_marginEnd="8dp"
    android:background="@color/surface"
    android:elevation="0dp" tools:ignore="Overdraw">

    <ImageView
        android:id="@+id/ivFrameThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_muted"
        android:contentDescription="@string/deformed_frames"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tvFrameBadge"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|start"
        android:layout_margin="4dp"
        android:background="@drawable/bg_frame_order_badge"
        android:gravity="center"
        android:textColor="@color/text_on_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="1" />
</FrameLayout>
