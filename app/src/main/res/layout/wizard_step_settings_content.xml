<?xml version="1.0" encoding="utf-8"?>
<!-- Runtime-inflated wizard settings; view count is inherent to the step. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="TooManyViews">
        <!-- Card: analysis mode — one setting, or a parameter sweep -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/surface_outline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/analysis_mode"
                        android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                        android:textColor="@color/viewer_chrome_text" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btnSweepInfo"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/info"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_info_min"
                        app:tint="@color/viewer_chrome_muted" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/rgAnalysisMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:checkedButton="@+id/rbModeSingle"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rbModeSingle"
                        style="@style/Widget.Semper.SegmentedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mode_single" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rbModeSweep"
                        style="@style/Widget.Semper.SegmentedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mode_sweep" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- Region of interest -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/surface_outline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/region_of_interest"
                    android:src="@drawable/ic_crop"
                    app:tint="@color/viewer_chrome_muted" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/region_of_interest"
                        android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                        android:textColor="@color/viewer_chrome_text" />

                    <TextView
                        android:id="@+id/tvInstruction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/viewer_chrome_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDefineRoi"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_edit" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- Card: Analysis parameters (dedicated settings page) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/advancedParamsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/surface_outline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/advancedParamsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_tune"
                        android:contentDescription="@string/parameters" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/advanced_parameters"
                        android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                        android:textColor="@color/viewer_chrome_text" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btnAdvancedReset"
                        style="@style/Widget.Semper.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_reset"
                        app:chipIcon="@drawable/ic_reset" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pasteParamsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:paddingBottom="4dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btnPasteParams"
                        style="@style/Widget.Semper.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_paste_params"
                        android:visibility="gone"
                        app:chipIcon="@drawable/ic_content_paste"
                        tools:visibility="visible" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/advancedParamsBody"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:visibility="visible">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/surface_outline" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/subset_size"
                            android:textColor="@color/viewer_chrome_text"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnSubsetInfo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/info"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_info_min"
                            app:tint="@color/viewer_chrome_muted" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />
                        <EditText
                            android:id="@+id/tvSubsetValue"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="end"
                            android:hint="@string/subset_size"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="3"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:text="@string/label_41"
                            android:textColor="@color/sky_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/scale_unit_px"
                            android:textColor="@color/sky_primary"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/etSubsetSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="15"
                        android:valueTo="121"
                        android:stepSize="2"
                        android:value="41" />

                    <!-- Measured speckle size for the loaded reference. Shown
                         whether or not it is a problem: it is the number the
                         subset recommendation rests on, and a user who can see
                         it can judge their own pattern. Gone until measured. -->
                    <TextView
                        android:id="@+id/tvSpeckleReadout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/viewer_chrome_muted"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="Speckle measures about 5.4 px across." />

                    <!-- The subset is too small to span three speckles. Lives
                         here rather than on step 1 with the size chips: this
                         is the one speckle message whose fix is the slider
                         directly above it, so moving the slider clears it in
                         place instead of somewhere the user cannot see. -->
                    <include
                        android:id="@+id/speckleSpanWarnRow"
                        layout="@layout/warn_chip_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/step_size_density"
                            android:textColor="@color/viewer_chrome_text"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnStepInfo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/info"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_info_min"
                            app:tint="@color/viewer_chrome_muted" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/overlap"
                            android:textColor="@color/viewer_chrome_text"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnOverlapInfo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/info"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_info_min"
                            app:tint="@color/viewer_chrome_muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.slider.Slider
                            android:id="@+id/etStepSize"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:valueFrom="1"
                            android:valueTo="30"
                            android:stepSize="1"
                            android:value="5" />

                        <EditText
                            android:id="@+id/tvStepValue"
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/step_size_density"
                            android:gravity="end"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:includeFontPadding="false"
                            android:inputType="number"
                            android:maxLength="2"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:text="@string/label_5"
                            android:textColor="@color/sky_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:includeFontPadding="false"
                            android:text="@string/scale_unit_px"
                            android:textColor="@color/sky_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/tvOverlapValue"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/subset_overlap"
                            android:gravity="end"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:includeFontPadding="false"
                            android:inputType="numberDecimal"
                            android:maxLength="4"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:textColor="@color/sky_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="0.88" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/etOverlap"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone"
                        android:valueFrom="50"
                        android:valueTo="99"
                        android:stepSize="1"
                        android:value="88" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/strain_window"
                            android:textColor="@color/viewer_chrome_text"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnStrainInfo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/info"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_info_min"
                            app:tint="@color/viewer_chrome_muted" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />
                        <EditText
                            android:id="@+id/tvStrainValue"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="end"
                            android:hint="@string/strain_window"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="3"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:text="@string/label_5"
                            android:textColor="@color/sky_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/strain_window_unit_points"
                            android:textColor="@color/sky_primary"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- In data points (VsgStudy.MIN_WINDOW_POINTS..MAX_WINDOW_POINTS);
                         tvStrainVsg below shows the VSG in px it gives at the current step. -->
                    <com.google.android.material.slider.Slider
                        android:id="@+id/etStrainWindow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="3"
                        android:valueTo="31"
                        android:stepSize="2"
                        android:value="5" />

                    <TextView
                        android:id="@+id/tvStrainVsg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/viewer_chrome_muted"
                        android:textSize="12sp"
                        tools:text="VSG 21 px at step 5 px" />



                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/sub_pixel_interpolation_kernel"
                        android:textColor="@color/viewer_chrome_text"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/rgInterpolator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:checkedButton="@+id/rbBicubic">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rbBicubic"
                            style="@style/Widget.Semper.SegmentedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/label_4_4_bicubic" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rbKeys"
                            style="@style/Widget.Semper.SegmentedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/label_6_6_keys" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Collapsible: sweep settings. cardCornerRadius/contentPadding/elevation
             inherit Widget.Semper.Card (the app theme's materialCardViewStyle).
             Stroke is surface_outline so force-dark still shows the card rim. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/sweepSettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/surface_outline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/sweepSettingsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/sweep_settings"
                        android:src="@drawable/ic_tune" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sweep_settings"
                            android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                            android:textColor="@color/viewer_chrome_text" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sweepBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:visibility="visible">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/surface_outline" />

                    <!-- Subset size range: min text | range slider | max text -->
                    <LinearLayout
                        android:id="@+id/subsetRangeBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/subset_range"
                            android:textColor="@color/viewer_chrome_text"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnSubsetRangeInfo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/info"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_info_min"
                            app:tint="@color/viewer_chrome_muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etSubsetMinValue"
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:hint="@string/subset_min"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="3"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:textColor="@color/sky_primary"
                            android:textStyle="bold"
                            tools:text="41" />

                        <com.google.android.material.slider.RangeSlider
                            android:id="@+id/rangeSubset"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:stepSize="2"
                            android:valueFrom="15"
                            android:valueTo="121"
                            app:values="@array/subset_range_default" />

                        <EditText
                            android:id="@+id/etSubsetMaxValue"
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:hint="@string/subset_max"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="3"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:textColor="@color/sky_primary"
                            android:textStyle="bold"
                            tools:text="61" />
                    </LinearLayout>
                    </LinearLayout>

                    <!-- Strain window range: titled and full-width, the
                         twin of the subset range above it. -->
                    <LinearLayout
                        android:id="@+id/strainWinRangeBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/strain_win_range"
                                android:textColor="@color/viewer_chrome_text"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/btnVsgMaxInfo"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="6dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/info"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_info_min"
                                app:tint="@color/viewer_chrome_muted" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/etStrainWinMinValue"
                                android:layout_width="46dp"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:gravity="center"
                                android:hint="@string/strain_win_min"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="3"
                                android:paddingTop="0dp"
                                android:paddingBottom="0dp"
                                android:textColor="@color/sky_primary"
                                android:textStyle="bold"
                                tools:text="3" />

                            <com.google.android.material.slider.RangeSlider
                                android:id="@+id/rangeStrainWin"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:stepSize="2"
                                android:valueFrom="3"
                                android:valueTo="31"
                                app:values="@array/strain_window_range_default" />

                            <EditText
                                android:id="@+id/etStrainWinMaxValue"
                                android:layout_width="46dp"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:gravity="center"
                                android:hint="@string/strain_win_max"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="3"
                                android:paddingTop="0dp"
                                android:paddingBottom="0dp"
                                android:textColor="@color/sky_primary"
                                android:textStyle="bold"
                                tools:text="11" />
                        </LinearLayout>
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <ImageButton
                            android:id="@+id/btnStepDepthInfo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/info"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_info_min"
                            app:tint="@color/viewer_chrome_muted" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilStepDepth"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:hint="@string/step_depth"
                            app:boxStrokeColor="@color/input_box_stroke"
                            app:hintTextColor="@color/viewer_chrome_muted"
                            app:prefixText="@string/step_depth_prefix">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etStepDepthValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textColor="@color/viewer_chrome_text"
                                tools:text="3" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilSweepOverlap"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/overlap"
                            app:boxStrokeColor="@color/input_box_stroke"
                            app:hintTextColor="@color/viewer_chrome_muted">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/tvSweepOverlapValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="numberDecimal"
                                android:maxLength="4"
                                android:textColor="@color/viewer_chrome_text"
                                tools:text="0.67" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <ImageButton
                            android:id="@+id/btnSweepOverlapInfo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/info"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_info_min"
                            app:tint="@color/viewer_chrome_muted" />
                    </LinearLayout>
                    <!-- Multi-frame only: collapsed summary (preview while picking) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickSweepFrame"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/sky_primary"
                        android:visibility="gone"
                        tools:text="img.png · Frame 3 of 12"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- Results chrome (Compute is in bottomNav) -->

        <include
            android:id="@+id/frameSizeWarnRow"
            layout="@layout/warn_chip_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- Status after Compute; ⓘ stays after an engine-failure dialog so FAQ
             is still reachable once Why? is gone. -->
        <LinearLayout
            android:id="@+id/runStatusRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/tvStaticResult"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/result"
                android:textAlignment="center"
                android:textColor="@color/viewer_chrome_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnEngineFailFaq"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/warn_faq_desc"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_info_min"
                android:visibility="gone"
                app:tint="@color/semantic_danger"
                tools:visibility="visible" />
        </LinearLayout>
</merge>
