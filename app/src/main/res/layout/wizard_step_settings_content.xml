<?xml version="1.0" encoding="utf-8"?>
<!-- Runtime-inflated wizard settings; view count is inherent to the step. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="TooManyViews">
        <!-- Analysis mode: one setting, or a parameter sweep. No card: the
             page is one flat list, sections split by dividers. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/rgAnalysisMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:checkedButton="@+id/rbModeSingle"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rbModeSingle"
                    style="@style/Widget.Semper.SegmentedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mode_single" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rbModeSweep"
                    style="@style/Widget.Semper.SegmentedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mode_sweep" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <ImageButton
                android:id="@+id/btnSweepInfo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/space_4"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/info"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_info_min"
                app:tint="@color/viewer_chrome_muted" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_16"
            android:background="@color/surface_outline" />

        <!-- Region of interest: the reference with the region drawn on it -->
        <LinearLayout
            android:id="@+id/roiRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_12"
            android:paddingBottom="@dimen/space_12">

            <com.sempermechanics.semper.ui.analysis.sweep.LineCutPreviewView
                android:id="@+id/roiThumb"
                android:layout_width="72dp"
                android:layout_height="48dp"
                android:contentDescription="@string/region_of_interest" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/region_of_interest"
                    android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                    android:textColor="@color/viewer_chrome_text" />

                <TextView
                    android:id="@+id/tvInstruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Semper.Numeric"
                    tools:text="1100 × 800 px · 8,800 points" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDefineRoi"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_edit" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/surface_outline" />

        <!-- Correlation parameters (single setting). Id kept from the card it
             replaced: the coach mark and Paste scroll to it. -->
        <LinearLayout
            android:id="@+id/advancedParamsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/param_section_correlation"
                    android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                    android:textColor="@color/viewer_chrome_text" />

                <ImageButton
                    android:id="@+id/btnPasteParams"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_paste_params"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_content_paste"
                    android:visibility="gone"
                    app:tint="@color/sky_primary"
                    tools:visibility="visible" />

                <ImageButton
                    android:id="@+id/btnAdvancedReset"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_reset"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_reset"
                    app:tint="@color/viewer_chrome_text" />
            </LinearLayout>

            <!-- Subset size, with the measured speckle beside it -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subset_size"
                    android:textColor="@color/viewer_chrome_text"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnSubsetInfo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/info"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_info_min"
                    app:tint="@color/viewer_chrome_muted" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSpeckle"
                    style="@style/Widget.Semper.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:checkable="false"
                    android:clickable="false"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:chipMinHeight="24dp"
                    app:ensureMinTouchTargetSize="false"
                    tools:text="Speckle 4.3 px"
                    tools:visibility="visible" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <EditText
                    android:id="@+id/etSubsetValue"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="end"
                    android:hint="@string/subset_size"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:textColor="@color/sky_primary"
                    android:textStyle="bold"
                    tools:text="41" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/scale_unit_px"
                    android:textColor="@color/sky_primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- The recommended band is drawn behind the track (SubsetBand); the
                 subset's ⓘ says what it means. -->
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderSubsetSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="2"
                android:value="41"
                android:valueFrom="15"
                android:valueTo="121" />

            <!-- The subset is too small to span three speckles. Its fix is the
                 slider above, so it clears in place as the slider moves. -->
            <include
                android:id="@+id/speckleSpanWarnRow"
                layout="@layout/view_warn_chip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:visibility="gone" />

            <!-- Step: the grid pitch. The points it gives are on the ROI row. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/param_step"
                    android:textColor="@color/viewer_chrome_text"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnStepInfo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/info"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_info_min"
                    app:tint="@color/viewer_chrome_muted" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <EditText
                    android:id="@+id/etStepValue"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/step_size_density"
                    android:gravity="end"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="2"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:textColor="@color/sky_primary"
                    android:textStyle="bold"
                    tools:text="5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/scale_unit_px"
                    android:textColor="@color/sky_primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderStepSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:value="5"
                android:valueFrom="1"
                android:valueTo="30" />

            <!-- The overlap's model; its field is under Advanced. -->
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderOverlap"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:stepSize="1"
                android:value="88"
                android:valueFrom="50"
                android:valueTo="99"
                android:visibility="gone" />

            <!-- Strain window, in data points, with the VSG in px beside the value -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/strain_window"
                    android:textColor="@color/viewer_chrome_text"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnStrainInfo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/info"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_info_min"
                    app:tint="@color/viewer_chrome_muted" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- The VSG the window gives at the current step. -->
                <TextView
                    android:id="@+id/tvStrainVsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_8"
                    android:textAppearance="@style/TextAppearance.Semper.Caption"
                    tools:text="21 px VSG" />

                <EditText
                    android:id="@+id/etStrainValue"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="end"
                    android:hint="@string/strain_window"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:textColor="@color/sky_primary"
                    android:textStyle="bold"
                    tools:text="5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/strain_window_unit_points"
                    android:textColor="@color/sky_primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- In data points (SweepStudy.MIN_WINDOW_POINTS..MAX_WINDOW_POINTS). -->
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderStrainWindow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="2"
                android:value="5"
                android:valueFrom="3"
                android:valueTo="31" />

            <!-- Advanced: overlap and interpolation, closed until opened (or until
                 a Paste changes one). CollapsibleSection opens and closes it. -->
            <include
                android:id="@+id/advancedHeader"
                layout="@layout/view_advanced_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16" />

            <LinearLayout
                android:id="@+id/advancedBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_8"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Overlap: follows the step (1 − step / subset); typing it rewrites the step. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/overlap"
                        android:textColor="@color/viewer_chrome_text"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnOverlapInfo"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/info"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_info_min"
                        app:tint="@color/viewer_chrome_muted" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <EditText
                        android:id="@+id/etOverlapValue"
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/subset_overlap"
                        android:gravity="end"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:maxLength="4"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:textColor="@color/sky_primary"
                        android:textStyle="bold"
                        tools:text="0.80" />
                </LinearLayout>

                <!-- Sub-pixel interpolation kernel -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/param_interpolation"
                        android:textColor="@color/viewer_chrome_text"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilInterpolator"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                        android:layout_width="168dp"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/sub_pixel_interpolation_kernel">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/ddInterpolator"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textSize="14sp"
                            tools:text="4×4 Bicubic" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Sweep setup (sweep mode): the frame the sweep solves and the lattice
             its ranges plan. The ranges are on the next page. Id kept from the
             card it replaced. -->
        <LinearLayout
            android:id="@+id/sweepSettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Multi-frame only: which frame the sweep solves. -->
            <LinearLayout
                android:id="@+id/sweepFrameBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgSweepFrame"
                        android:layout_width="72dp"
                        android:layout_height="48dp"
                        android:background="@color/surface_outline"
                        android:contentDescription="@string/sweep_frame_enlarge"
                        android:foreground="?attr/selectableItemBackground"
                        android:scaleType="centerCrop" />

                    <!-- No floating label: the hint stays on the field for TalkBack,
                         and the frame's position ("3 / 5") is its suffix. -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSweepFrame"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        app:boxStrokeColor="@color/input_box_stroke"
                        app:endIconContentDescription="@string/sweep_frame"
                        app:endIconDrawable="@drawable/ic_expand_more"
                        app:endIconMode="custom"
                        app:hintEnabled="false"
                        app:suffixTextColor="@color/viewer_chrome_muted">

                        <!-- Looks like a dropdown; a tap opens the frame dialog with its preview. -->
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/ddSweepFrame"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:ellipsize="middle"
                            android:focusable="false"
                            android:hint="@string/sweep_frame"
                            android:importantForAutofill="no"
                            android:inputType="none"
                            android:maxLines="1"
                            android:textSize="14sp"
                            tools:text="steel_23.tif" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Which frame to pick (sweep_frame_hint). -->
                    <ImageButton
                        android:id="@+id/btnSweepFrameInfo"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/info"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_info_min"
                        app:tint="@color/viewer_chrome_muted" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@color/surface_outline" />
            </LinearLayout>

            <!-- The planned lattice: one node per analysis. The coach mark points here. -->
            <LinearLayout
                android:id="@+id/sweepSettingsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/planned_lattice_heading"
                    android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                    android:textColor="@color/viewer_chrome_text" />

                <!-- "9 runs": how many analyses the plan holds; gone when it holds none. -->
                <TextView
                    android:id="@+id/tvSweepRunCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:textAppearance="@style/TextAppearance.Semper.Caption"
                    tools:text="9 runs" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- bg_chrome_ghost, not a borderless ripple: a standalone
                     40dp icon-only button, same role as the toolbar buttons
                     it matches (activity_result_viewer.xml, activity_vsg_lattice.xml). -->
                <ImageButton
                    android:id="@+id/btnLatticeSamples"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_chrome_ghost"
                    android:contentDescription="@string/lattice_samples_settings"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings_gear"
                    app:tint="@color/viewer_chrome_text" />
            </LinearLayout>

            <!-- How many values each range is sampled at; the gear shows it. -->
            <LinearLayout
                android:id="@+id/latticeSamplesBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageButton
                    android:id="@+id/btnSamplesInfo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/info"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_info_min"
                    app:tint="@color/viewer_chrome_muted" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSubsetSamples"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:hint="@string/subset_samples"
                    app:boxStrokeColor="@color/input_box_stroke"
                    app:hintTextColor="@color/viewer_chrome_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSubsetSamplesValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textColor="@color/viewer_chrome_text"
                        tools:text="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilVsgSamples"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/vsg_samples"
                    app:boxStrokeColor="@color/input_box_stroke"
                    app:hintTextColor="@color/viewer_chrome_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etVsgSamplesValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textColor="@color/viewer_chrome_text"
                        tools:text="3" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Matches the result lattice's height (compact=true set in
                 SweepSetupController.setup()) so the planned and solved lattices
                 read as the same element at two points in the flow. -->
            <com.sempermechanics.semper.ui.analysis.sweep.SweepLatticeView
                android:id="@+id/sweepLatticePreview"
                android:layout_width="match_parent"
                android:layout_height="136dp"
                android:layout_marginTop="@dimen/space_8" />

            <include
                android:id="@+id/sweepPlanWarnRow"
                layout="@layout/view_warn_chip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Results chrome (Compute is in bottomNav) -->

        <include
            android:id="@+id/frameSizeWarnRow"
            layout="@layout/view_warn_chip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- Status after Compute; ⓘ stays after an engine-failure dialog so FAQ
             is still reachable once Why? is gone. -->
        <LinearLayout
            android:id="@+id/runStatusRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/tvStaticResult"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/result"
                android:textAlignment="center"
                android:textColor="@color/viewer_chrome_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnEngineFailFaq"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/warn_faq_desc"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_info_min"
                android:visibility="gone"
                app:tint="@color/semantic_danger"
                tools:visibility="visible" />
        </LinearLayout>
</merge>
