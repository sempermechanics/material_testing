<?xml version="1.0" encoding="utf-8"?>
<!-- One first-run tip (CoachMarkController): an optional illustration, the
     tip, then "1 of 3" on the left and Skip / Next on the right. Single tips
     hide the count and Skip, and Next reads "Got it". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coachCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_coach_card"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/coachIllustration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:adjustViewBounds="true"
        android:forceDarkAllowed="false"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- Polite live region: TalkBack reads each tip as it appears. -->
    <TextView
        android:id="@+id/coachMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        tools:text="Each dot is one combination. Tap a filled one to focus its curve; tap a hollow one for the reason." />

    <LinearLayout
        android:id="@+id/coachActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/coachCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="1 of 3"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/coachSkip"
            style="@style/Widget.Semper.Button.Text.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/coach_skip" />

        <Space
            android:layout_width="8dp"
            android:layout_height="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/coachNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/coach_next" />
    </LinearLayout>
</LinearLayout>
