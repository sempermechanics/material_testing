<?xml version="1.0" encoding="utf-8"?>
<!--
  One analysis, wherever it lives: the state line says whether it is on this
  phone, in the cloud, or both, and only the actions that apply are shown.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_settings_card"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAnalysisName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAnalysisState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAnalysisBackup"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:textAllCaps="false"
        android:visibility="gone" />

    <!-- Save a zip to Files / Share (does not change the on-phone session). -->
    <ImageButton
        android:id="@+id/btnAnalysisLocalDownload"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/download_local_action"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_download"
        android:visibility="gone"
        app:tint="@color/sky_primary" />

    <!-- Restore from cloud into app storage (may replace local frames). -->
    <ImageButton
        android:id="@+id/btnAnalysisRestore"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/restore_action"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_cloud_download"
        android:visibility="gone"
        app:tint="@color/sky_primary" />

    <ImageButton
        android:id="@+id/btnAnalysisDelete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cloud_delete_backup"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_delete"
        android:visibility="gone"
        app:tint="@color/semantic_danger" />
</LinearLayout>
