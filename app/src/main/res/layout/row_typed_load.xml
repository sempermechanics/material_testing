<?xml version="1.0" encoding="utf-8"?>
<!-- One deformed frame in the typed-loads sheet: thumbnail, which photo, and
     its hanger mass in kg. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <ImageView
        android:id="@+id/ivTypedThumb"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@color/surface_outline"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTypedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Photo 3" />

        <TextView
            android:id="@+id/tvTypedSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="IMG_20260928_101502.jpg" />
    </LinearLayout>

    <EditText
        android:id="@+id/etTypedKg"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:hint="@string/load_typed_hint"
        android:imeOptions="actionNext|flagNoExtractUi"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:maxLength="8"
        android:minHeight="48dp"
        android:textColor="@color/sky_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/unit_kg"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />
</LinearLayout>
