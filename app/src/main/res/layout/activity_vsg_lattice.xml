<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_muted"
    android:orientation="vertical"
    tools:ignore="Overdraw">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="2dp"
        android:minHeight="?attr/actionBarSize"
        app:navigationIconTint="@color/text_primary"
        app:title="@string/vsg_lattice_title"
        app:titleTextColor="@color/text_primary" />

    <!-- Scrolling column: lattice, controls, then plot; action bar stays pinned below. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentPadding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vsg_lattice_heading"
                    android:textAppearance="@style/TextAppearance.Semper.SectionHeader" />

                <TextView
                    android:id="@+id/tvLatticeSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="12 combinations · 10 solved · 2 skipped" />

                <com.indicvision.semper.ui.analysis.VsgLatticeView
                    android:id="@+id/latticeView"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot_solved" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="18dp"
                        android:text="@string/vsg_lattice_legend_solved"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot_skipped" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/vsg_lattice_legend_skipped"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/vsg_lattice_caption"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Prev · param chip · next — primary one-thumb selection. -->
        <LinearLayout
            android:id="@+id/stepperRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPrevNode"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/vsg_lattice_prev"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_prev"
                app:tint="@color/sky_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSelectedParams"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/vsg_lattice_readout_copy_hint"
                android:focusable="true"
                android:gravity="center"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/sky_container"
                app:chipStrokeColor="@color/surface_outline"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="false"
                tools:text="ss:41 · st:5 · sw:15" />

            <ImageButton
                android:id="@+id/btnNextNode"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/vsg_lattice_next"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_next"
                app:tint="@color/sky_primary" />
        </LinearLayout>

        <!-- Centre-line strain profiles; plot has a fixed tall height in the scroll. -->
        <LinearLayout
            android:id="@+id/strainPlotSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipChildren="false"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStrainPlotTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Strain along X" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/togglePlotMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:checkedButton="@id/btnPlotHighlight"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlotHighlight"
                        style="@style/Widget.Semper.SegmentedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="32dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/vsg_lattice_curves_all"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlotIsolate"
                        style="@style/Widget.Semper.SegmentedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="32dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/vsg_lattice_curves_node"
                        android:textSize="12sp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <Spinner
                    android:id="@+id/spinnerStrainComponent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <com.indicvision.semper.ui.analysis.VsgPlotView
                android:id="@+id/plotLatticeStrain"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="4dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderScrub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:contentDescription="@string/vsg_lattice_scrub_slider"
                android:stepSize="0"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="1" />

            <TextView
                android:id="@+id/tvStrainPlotReadout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:clickable="true"
                android:contentDescription="@string/vsg_lattice_readout_copy_hint"
                android:focusable="true"
                android:minLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="x=24.0 · y=0.0031 · subset 41 · step 5 · strain 15" />
        </LinearLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:paddingTop="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveGraph"
            style="@style/Widget.Semper.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:textSize="15sp"
            app:cornerRadius="12dp"
            android:text="@string/vsg_lattice_save_graph" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnView"
            style="@style/Widget.Semper.Button.Cta"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:textSize="15sp"
            app:cornerRadius="12dp"
            android:text="@string/vsg_lattice_view" />
    </LinearLayout>
</LinearLayout>
