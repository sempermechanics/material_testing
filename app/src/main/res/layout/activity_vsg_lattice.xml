<?xml version="1.0" encoding="utf-8"?>
<!-- Same minimal-chrome vocabulary as the result viewer (glass pucks, hairline
     rules, zero elevation, monospace numerics); see viewer_* tokens in
     colors.xml. forceDarkAllowed=false: every colour on this screen is an
     explicit day/night resource now, so the OS's force-dark auto-invert would
     only double-apply on top of the already-tuned glass fills. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viewer_canvas"
    android:forceDarkAllowed="false"
    android:orientation="vertical"
    tools:ignore="Overdraw"
    tools:targetApi="29">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/viewer_canvas"
        android:elevation="0dp"
        android:minHeight="?attr/actionBarSize"
        app:navigationIconTint="@color/viewer_chrome_text"
        app:title="@string/vsg_lattice_title"
        app:titleTextColor="@color/viewer_chrome_text" />

    <!-- Scrolling column: lattice, controls, then plot; action bar stays pinned below. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvLatticeSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/viewer_chrome_muted"
            android:textSize="12sp"
            tools:text="12 combinations · 10 solved · 2 skipped" />

        <!-- compact=true (VsgLatticeActivity): no separate axis-title lines, the
             coach mark already explains both axes on first open. -->
        <com.indicvision.semper.ui.analysis.VsgLatticeView
            android:id="@+id/latticeView"
            android:layout_width="match_parent"
            android:layout_height="136dp"
            android:layout_marginTop="6dp" />

        <!-- Prev · param chip · next: primary one-thumb selection. -->
        <LinearLayout
            android:id="@+id/stepperRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPrevNode"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chrome_ghost"
                android:contentDescription="@string/vsg_lattice_prev"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_prev"
                app:tint="@color/viewer_chrome_text" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSelectedParams"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/vsg_lattice_readout_copy_hint"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="@color/viewer_chrome_text"
                android:textSize="13sp"
                app:chipBackgroundColor="@color/viewer_glass_fill"
                app:chipStrokeColor="@color/viewer_glass_stroke"
                app:chipStrokeWidth="0.5dp"
                app:ensureMinTouchTargetSize="false"
                app:rippleColor="@color/viewer_glass_ripple"
                tools:text="ss:41 · st:5 · sw:15" />

            <ImageButton
                android:id="@+id/btnNextNode"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chrome_ghost"
                android:contentDescription="@string/vsg_lattice_next"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_next"
                app:tint="@color/viewer_chrome_text" />
        </LinearLayout>

        <!-- Centre-line strain profiles; plot has a fixed tall height in the scroll. -->
        <LinearLayout
            android:id="@+id/strainPlotSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStrainPlotTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/viewer_chrome_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Strain along X" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/togglePlotMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:checkedButton="@id/btnPlotHighlight"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlotHighlight"
                        style="@style/Widget.Semper.SegmentedButton.ViewerImmersive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vsg_lattice_curves_all" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlotIsolate"
                        style="@style/Widget.Semper.SegmentedButton.ViewerImmersive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vsg_lattice_curves_node" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <Spinner
                    android:id="@+id/spinnerStrainComponent"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_pill_glass"
                    android:paddingHorizontal="12dp"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <!-- compactAxes=true (VsgLatticeActivity): no separate axis-title
                 lines, the unit folds onto the outermost tick instead. -->
            <com.indicvision.semper.ui.analysis.VsgPlotView
                android:id="@+id/plotLatticeStrain"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="6dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderScrub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:contentDescription="@string/vsg_lattice_scrub_slider"
                android:stepSize="0"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="1" />

            <!-- x only: y is already at the scrub point on the plot itself, and
                 params are already on chipSelectedParams above. -->
            <TextView
                android:id="@+id/tvStrainPlotReadout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:minLines="1"
                android:textColor="@color/viewer_chrome_muted"
                android:textSize="12sp"
                tools:text="x=24.0" />
        </LinearLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/actionBarRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:paddingTop="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveGraph"
            style="@style/Widget.Semper.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:textSize="15sp"
            app:cornerRadius="12dp"
            android:text="@string/vsg_lattice_save_graph" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnView"
            style="@style/Widget.Semper.Button.Cta"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:textSize="15sp"
            app:cornerRadius="12dp"
            android:text="@string/vsg_lattice_view" />
    </LinearLayout>
</LinearLayout>
