<?xml version="1.0" encoding="utf-8"?>
<!-- Sweep settings (page 3): the ranges the sweep covers, then the axis its
     strain is read along. The lattice they plan is on page 2. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollStepSweep"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/sweepColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Subset range: min text | range slider | max text -->
        <LinearLayout
            android:id="@+id/subsetRangeBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sweep_subset"
                android:textColor="@color/viewer_chrome_text"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnSubsetRangeInfo"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/info"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_info_min"
                app:tint="@color/viewer_chrome_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etSubsetMinValue"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:hint="@string/subset_min"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="3"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textColor="@color/sky_primary"
                android:textStyle="bold"
                tools:text="41" />

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/rangeSubset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:stepSize="2"
                android:valueFrom="15"
                android:valueTo="121"
                app:values="@array/subset_range_default" />

            <EditText
                android:id="@+id/etSubsetMaxValue"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:hint="@string/subset_max"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="3"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textColor="@color/sky_primary"
                android:textStyle="bold"
                tools:text="61" />
        </LinearLayout>
        </LinearLayout>

        <!-- Strain window range: titled and full-width, the twin of the subset
             range above it, with the VSG span it plans on its title row. -->
        <LinearLayout
            android:id="@+id/strainWinRangeBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/strain_window"
                    android:textColor="@color/viewer_chrome_text"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnVsgMaxInfo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/info"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_info_min"
                    app:tint="@color/viewer_chrome_muted" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvStrainWinVsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Semper.Caption"
                    tools:text="11–121 px VSG" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etStrainWinMinValue"
                    android:layout_width="46dp"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:hint="@string/strain_win_min"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:textColor="@color/sky_primary"
                    android:textStyle="bold"
                    tools:text="3" />

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/rangeStrainWin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:stepSize="2"
                    android:valueFrom="3"
                    android:valueTo="31"
                    app:values="@array/strain_window_range_default" />

                <EditText
                    android:id="@+id/etStrainWinMaxValue"
                    android:layout_width="46dp"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:hint="@string/strain_win_max"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:textColor="@color/sky_primary"
                    android:textStyle="bold"
                    tools:text="11" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <ImageButton
                android:id="@+id/btnStepDepthInfo"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/info"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_info_min"
                app:tint="@color/viewer_chrome_muted" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStepDepth"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/step_depth"
                app:boxStrokeColor="@color/input_box_stroke"
                app:hintTextColor="@color/viewer_chrome_muted"
                app:prefixText="@string/step_depth_prefix">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStepDepthValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="@color/viewer_chrome_text"
                    tools:text="3" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Advanced: the overlap the step gives, closed until opened.
             CollapsibleSection opens and closes it, as on the parameters page. -->
        <include
            android:id="@+id/sweepAdvancedHeader"
            layout="@layout/view_advanced_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12" />

        <LinearLayout
            android:id="@+id/sweepAdvancedBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSweepOverlap"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/overlap"
                app:boxStrokeColor="@color/input_box_stroke"
                app:hintTextColor="@color/viewer_chrome_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSweepOverlapValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLength="4"
                    android:textColor="@color/viewer_chrome_text"
                    tools:text="0.67" />
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/btnSweepOverlapInfo"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/info"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_info_min"
                app:tint="@color/viewer_chrome_muted" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_12"
            android:background="@color/surface_outline" />

        <!-- Line cut axis. Id kept from the card it replaced: the coach mark points here. -->
        <LinearLayout
            android:id="@+id/lineCutPreviewCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/line_cut_axis"
                    android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                    android:textColor="@color/viewer_chrome_text" />

                <ImageButton
                    android:id="@+id/btnLineCutInfo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/info"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_info_min"
                    app:tint="@color/viewer_chrome_muted" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/rgLineCutAxis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                app:checkedButton="@+id/rbAxisX"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rbAxisX"
                    style="@style/Widget.Semper.SegmentedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/line_cut_along_x"
                    android:text="@string/line_cut_x" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rbAxisY"
                    style="@style/Widget.Semper.SegmentedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/line_cut_along_y"
                    android:text="@string/line_cut_y" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Tap to open it larger; tap again for the strip. Opened, a wide
                 reference runs past the screen edge and scrolls sideways. -->
            <HorizontalScrollView
                android:id="@+id/lineCutScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:fillViewport="true"
                android:scrollbars="none">

                <!-- wrap_content: fillViewport stretches it to the page as a strip. -->
                <com.sempermechanics.semper.ui.analysis.sweep.LineCutPreviewView
                    android:id="@+id/lineCutPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/line_cut_preview_strip"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
