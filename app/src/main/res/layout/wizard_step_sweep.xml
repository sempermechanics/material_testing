<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollStepSweep"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/sweepColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Collapsible: sweep settings. cardCornerRadius/contentPadding/elevation
             inherit Widget.Semper.Card (the app theme's materialCardViewStyle);
             only the fill and stroke move to the glass-pill hairline treatment,
             matching the result lattice/viewer. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/viewer_glass_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/sweepSettingsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/sweep_settings"
                        android:src="@drawable/ic_tune" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sweep_settings"
                            android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                            android:textColor="@color/viewer_chrome_text" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sweepBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:visibility="visible">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/viewer_glass_stroke" />

                    <!-- Subset size range: min text | range slider | max text -->
                    <LinearLayout
                        android:id="@+id/subsetRangeBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/subset_range"
                            android:textColor="@color/viewer_chrome_text"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnSubsetRangeInfo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/info"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_info_min"
                            app:tint="@color/viewer_chrome_muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etSubsetMinValue"
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:hint="@string/subset_min"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="3"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:textColor="@color/sky_primary"
                            android:textStyle="bold"
                            tools:text="41" />

                        <com.google.android.material.slider.RangeSlider
                            android:id="@+id/rangeSubset"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:stepSize="2"
                            android:valueFrom="15"
                            android:valueTo="121"
                            app:values="@array/subset_range_default" />

                        <EditText
                            android:id="@+id/etSubsetMaxValue"
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:hint="@string/subset_max"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="3"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:textColor="@color/sky_primary"
                            android:textStyle="bold"
                            tools:text="61" />
                    </LinearLayout>
                    </LinearLayout>

                    <!-- Strain window range: titled and full-width, the
                         twin of the subset range above it. -->
                    <LinearLayout
                        android:id="@+id/strainWinRangeBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/strain_win_range"
                                android:textColor="@color/viewer_chrome_text"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/btnVsgMaxInfo"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="6dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/info"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_info_min"
                                app:tint="@color/viewer_chrome_muted" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/etStrainWinMinValue"
                                android:layout_width="46dp"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:gravity="center"
                                android:hint="@string/strain_win_min"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="3"
                                android:paddingTop="0dp"
                                android:paddingBottom="0dp"
                                android:textColor="@color/sky_primary"
                                android:textStyle="bold"
                                tools:text="5" />

                            <com.google.android.material.slider.RangeSlider
                                android:id="@+id/rangeStrainWin"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:stepSize="2"
                                android:valueFrom="5"
                                android:valueTo="101"
                                app:values="@array/strain_window_range_default" />

                            <EditText
                                android:id="@+id/etStrainWinMaxValue"
                                android:layout_width="46dp"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:gravity="center"
                                android:hint="@string/strain_win_max"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="3"
                                android:paddingTop="0dp"
                                android:paddingBottom="0dp"
                                android:textColor="@color/sky_primary"
                                android:textStyle="bold"
                                tools:text="101" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Step size gets its own row rather than sharing
                         one with a range control. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnStepDepthInfo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/info"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_info_min"
                            app:tint="@color/viewer_chrome_muted" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilStepDepth"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/step_depth"
                            app:boxStrokeColor="@color/sky_primary"
                            app:hintTextColor="@color/viewer_chrome_muted"
                            app:prefixText="@string/step_depth_prefix">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etStepDepthValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textColor="@color/viewer_chrome_text"
                                tools:text="3" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Multi-frame only: collapsed summary (preview while picking) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickSweepFrame"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/sky_primary"
                        android:visibility="gone"
                        tools:text="img.png · Frame 3 of 12"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Always visible: planned lattice -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/plannedLatticeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/viewer_glass_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/planned_lattice_heading"
                        android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                        android:textColor="@color/viewer_chrome_text" />

                    <!-- bg_chrome_ghost, not a borderless ripple: a standalone
                         40dp icon-only button, same role as the toolbar buttons
                         it now matches (activity_result_viewer.xml, activity_vsg_lattice.xml). -->
                    <ImageButton
                        android:id="@+id/btnLatticeSamples"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chrome_ghost"
                        android:contentDescription="@string/lattice_samples_settings"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_settings_gear"
                        app:tint="@color/viewer_chrome_text" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/latticeSamplesBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnSamplesInfo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/info"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_info_min"
                            app:tint="@color/viewer_chrome_muted" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilSubsetSamples"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:hint="@string/subset_samples"
                            app:boxStrokeColor="@color/sky_primary"
                            app:hintTextColor="@color/viewer_chrome_muted">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSubsetSamplesValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textColor="@color/viewer_chrome_text"
                                tools:text="3" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilVsgSamples"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/vsg_samples"
                            app:boxStrokeColor="@color/sky_primary"
                            app:hintTextColor="@color/viewer_chrome_muted">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etVsgSamplesValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textColor="@color/viewer_chrome_text"
                                tools:text="3" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Matches the result lattice's height (compact=true set in
                     SweepSetupHelper.setup()) so the planned and solved lattices
                     read as the same element at two points in the flow. -->
                <com.indicvision.semper.ui.analysis.VsgLatticeView
                    android:id="@+id/sweepLatticePreview"
                    android:layout_width="match_parent"
                    android:layout_height="136dp"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tvSweepPlan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/viewer_chrome_muted"
                    android:textSize="12sp"
                    tools:text="8 analyses" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>
</ScrollView>
