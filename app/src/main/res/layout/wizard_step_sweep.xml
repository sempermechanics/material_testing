<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollStepSweep"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/sweepColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Always visible: planned lattice -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/plannedLatticeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/viewer_glass_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/planned_lattice_heading"
                        android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                        android:textColor="@color/viewer_chrome_text" />

                    <!-- bg_chrome_ghost, not a borderless ripple: a standalone
                         40dp icon-only button, same role as the toolbar buttons
                         it now matches (activity_result_viewer.xml, activity_vsg_lattice.xml). -->
                    <ImageButton
                        android:id="@+id/btnLatticeSamples"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chrome_ghost"
                        android:contentDescription="@string/lattice_samples_settings"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_settings_gear"
                        app:tint="@color/viewer_chrome_text" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/latticeSamplesBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnSamplesInfo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/info"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_info_min"
                            app:tint="@color/viewer_chrome_muted" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilSubsetSamples"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:hint="@string/subset_samples"
                            app:boxStrokeColor="@color/sky_primary"
                            app:hintTextColor="@color/viewer_chrome_muted">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSubsetSamplesValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textColor="@color/viewer_chrome_text"
                                tools:text="3" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilVsgSamples"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/vsg_samples"
                            app:boxStrokeColor="@color/sky_primary"
                            app:hintTextColor="@color/viewer_chrome_muted">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etVsgSamplesValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textColor="@color/viewer_chrome_text"
                                tools:text="3" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Matches the result lattice's height (compact=true set in
                     SweepSetupHelper.setup()) so the planned and solved lattices
                     read as the same element at two points in the flow. -->
                <com.indicvision.semper.ui.analysis.VsgLatticeView
                    android:id="@+id/sweepLatticePreview"
                    android:layout_width="match_parent"
                    android:layout_height="136dp"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tvSweepPlan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/viewer_chrome_muted"
                    android:textSize="12sp"
                    tools:text="8 analyses" />

                <include
                    android:id="@+id/sweepPlanWarnRow"
                    layout="@layout/warn_chip_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Line-cut preview: Parameter sweep only -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/lineCutPreviewCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/viewer_glass_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/line_cut_preview_heading"
                        android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                        android:textColor="@color/viewer_chrome_text" />

                    <ImageButton
                        android:id="@+id/btnLineCutInfo"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/info"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_info_min"
                        app:tint="@color/viewer_chrome_muted" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/rgLineCutAxis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:checkedButton="@+id/rbAxisX"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rbAxisX"
                        style="@style/Widget.Semper.SegmentedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/axis_x" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rbAxisY"
                        style="@style/Widget.Semper.SegmentedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/axis_y" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.indicvision.semper.ui.analysis.LineCutPreviewView
                    android:id="@+id/lineCutPreview"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
