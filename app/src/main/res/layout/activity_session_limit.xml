<?xml version="1.0" encoding="utf-8"?>
<!-- Scrolls, so the recovery actions stay reachable at a large font scale
     (readiness AE1V-008); fillViewport keeps the column centred when it fits. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_muted"
    android:fillViewport="true" tools:ignore="Overdraw">

    <LinearLayout
        android:id="@+id/limitRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_warn_chip"
            android:contentDescription="@string/limit_title"
            android:padding="14dp"
            android:src="@android:drawable/stat_sys_warning"
            app:tint="@color/semantic_warning_ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/limit_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLimitBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:maxWidth="300dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvLimitQuota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/sky_on_container"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_warn_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp" />

        <!-- The way on: free room, then re-check (the cap counts stored analyses). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecheckLimit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/limit_recheck" />

        <!-- The account's licence is there, and this phone is not on it (ADR-033). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLimitActivate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/phones_activate"
            android:visibility="gone" />

        <!-- For an account that expects a seat or a licence (LicenseRefresh). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefreshLicense"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/license_refresh_action"
            android:textColor="@color/sky_primary" />

        <!-- A neutral way to reach support; it asks for nothing. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmailSupport"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/limit_email_support"
            android:textAllCaps="false"
            android:textColor="@color/sky_primary" />

        <ProgressBar
            android:id="@+id/progressLimit"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginTop="10dp"
            android:indeterminateTint="@color/sky_primary"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/tvLimitBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:padding="6dp"
            android:text="@string/limit_back"
            android:textColor="@color/sky_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
