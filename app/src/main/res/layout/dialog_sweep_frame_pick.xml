<?xml version="1.0" encoding="utf-8"?>
<!--
  One custom view for the whole dialog: the frame list scrolls at the top, the
  number field and the preview stay put beneath it. Handing the list to
  setSingleChoiceItems instead puts it in the dialog's weighted content panel,
  where a long list squeezes the preview out of view entirely.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp">

    <!-- Grows with the frame count, then scrolls: constrainedHeight caps it. -->
    <ScrollView
        android:id="@+id/scrollSweepFrames"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="200dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RadioGroup
            android:id="@+id/rgSweepFrames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Type a frame number instead of scrolling to it. -->
    <LinearLayout
        android:id="@+id/sweepFrameNumberRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollSweepFrames">

        <EditText
            android:id="@+id/etSweepFrameNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="center"
            android:hint="@string/sweep_frame"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="3"
            android:minWidth="40dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:selectAllOnFocus="true"
            android:textColor="@color/sky_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="2" />

        <TextView
            android:id="@+id/tvSweepFrameTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="out of 12" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/sweepFramePreviewBox"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="@color/surface_muted"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sweepFrameNumberRow">

        <ImageView
            android:id="@+id/ivSweepFrameDialogPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/sweep_frame"
            android:scaleType="fitCenter" />

        <ProgressBar
            android:id="@+id/progressSweepFramePreview"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
