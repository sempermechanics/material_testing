<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sessionCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/surface_muted"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/surface_outline"
    app:strokeWidth="1dp" tools:ignore="SmallSp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- The tick replaces the thumbnail while selected, so the row keeps
             its height and nothing shifts when selection mode toggles. -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/sessionThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/viewer_chip_off"
                android:contentDescription="@string/home_thumb_desc"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/sessionCheck"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/sky_container"
                android:contentDescription="@string/selection_selected_desc"
                android:padding="8dp"
                android:src="@drawable/ic_check_circle"
                android:visibility="gone"
                app:tint="@color/sky_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sessionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sessionSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Shown only while this session's backup is running. -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/sessionProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                app:indicatorColor="@color/sky_primary"
                app:trackCornerRadius="2dp"
                app:trackThickness="3dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/sessionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/badge_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
