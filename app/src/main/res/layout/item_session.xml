<?xml version="1.0" encoding="utf-8"?>
<!-- One Home row: a card on the list's surface; a selected row takes the
     sky fill and stroke (SessionListAdapter). Day headers between the cards
     are item_session_header. The card's own 12dp contentPadding is the only
     padding: the theme's card style would otherwise add 16dp around it. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sessionCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/surface_muted"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:contentPadding="@dimen/space_12"
    app:strokeColor="@color/surface_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- The result heatmap covers the reference once it has rendered;
             until then, or with no frames on the phone, the reference shows
             through. The tick replaces both while selected, so the row keeps
             its height and nothing shifts when selection mode toggles. -->
        <FrameLayout
            android:layout_width="@dimen/session_thumb_size"
            android:layout_height="@dimen/session_thumb_size">

            <ImageView
                android:id="@+id/sessionThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/viewer_chip_off"
                android:contentDescription="@string/home_thumb_desc"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/sessionResultThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/sessionCheck"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/sky_container"
                android:contentDescription="@string/selection_selected_desc"
                android:padding="@dimen/space_8"
                android:src="@drawable/ic_check_circle"
                android:visibility="gone"
                app:tint="@color/sky_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sessionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="steel_00" />

            <TextView
                android:id="@+id/sessionSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Semper.Numeric"
                tools:text="40 frames · 96.3%" />

            <!-- Shown only while this session's transfer is running. -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/sessionProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:visibility="gone"
                app:indicatorColor="@color/sky_primary"
                app:trackColor="@color/surface_outline"
                app:trackThickness="2dp" />
        </LinearLayout>

        <!-- Where the backup stands; a tap retries or backs up (BackupBadgeActions).
             A 20dp glyph in a 40dp target. -->
        <ImageView
            android:id="@+id/sessionState"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/space_4"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sync_state_not_backed_up"
            android:padding="10dp"
            android:src="@drawable/ic_cloud_off"
            app:tint="@color/text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
