<?xml version="1.0" encoding="utf-8"?>
<!-- Details sheet: max/min with coords + mean, then settings used. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/viewer_chrome_bg"
    android:forceDarkAllowed="false"
    android:orientation="vertical"
    android:paddingHorizontal="22dp"
    android:paddingTop="10dp"
    android:paddingBottom="28dp"
    tools:targetApi="29">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/viewer_chrome_muted" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.01"
        android:text="@string/viewer_details_title"
        android:textColor="@color/viewer_chrome_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSettingsUsedSpecimen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="@color/viewer_chrome_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvSheetStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/viewer_chrome_text"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:letterSpacing="0.08"
        android:text="@string/settings_used_title"
        android:textAllCaps="true"
        android:textColor="@color/viewer_chrome_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/settingsUsedRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/lineCutSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvLineCutTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textColor="@color/viewer_chrome_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.indicvision.semper.ui.analysis.VsgPlotView
            android:id="@+id/plotLineCut"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvLineCutLegend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/viewer_chrome_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
