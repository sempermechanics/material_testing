<?xml version="1.0" encoding="utf-8"?>
<!-- The engine settings a result was actually produced with. Populated at
     runtime from the intent extras the viewer was launched with, so it always
     reflects THIS analysis rather than the app's current settings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="34dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@color/surface_outline" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_used_title"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSettingsUsedSpecimen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/settingsUsedRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_settings_card"
        android:orientation="vertical"
        android:padding="14dp" />

    <!-- Line cut through the ROI centre. Only a parameter sweep populates it:
         every combination is read along the same physical line, so the strain
         profiles of different VSG sizes can be compared directly. -->
    <LinearLayout
        android:id="@+id/lineCutSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvLineCutTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.indicvision.semper.ui.analysis.VsgPlotView
            android:id="@+id/plotLineCut"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvLineCutLegend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
