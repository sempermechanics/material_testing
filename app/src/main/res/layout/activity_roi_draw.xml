<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viewer_canvas">

    <!-- forceDarkAllowed=false: the specimen image and ROI strokes keep
         their exact colors in dark mode. -->
    <FrameLayout
        android:id="@+id/canvasFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:forceDarkAllowed="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgRoiCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@string/roi_canvas_image" />

        <com.rafad.indicvisiondic.ui.analysis.StudioOverlayView
            android:id="@+id/overlayRoi"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_viewer_panel"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/roi_hud_select_tool"
        android:textAppearance="@style/TextAppearance.IndicVision.Caption"
        android:textColor="@color/viewer_on_dark"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <HorizontalScrollView
        android:id="@+id/bottomToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_viewer_panel"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelRoi"
                style="@style/Widget.IndicVision.Button.Text.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetRoi"
                style="@style/Widget.IndicVision.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/reset"
                android:textColor="@color/viewer_on_dark"
                app:strokeColor="#55FFFFFF" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/rgDrawMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedButton="@+id/rbRect"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rbRect"
                    style="@style/Widget.IndicVision.SegmentedButton.Dark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/roi_mode_rect" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rbSquare"
                    style="@style/Widget.IndicVision.SegmentedButton.Dark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/roi_mode_square" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rbCircle"
                    style="@style/Widget.IndicVision.SegmentedButton.Dark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/roi_mode_circle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rbEllipse"
                    style="@style/Widget.IndicVision.SegmentedButton.Dark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/roi_mode_ellipse" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rbFreeform"
                    style="@style/Widget.IndicVision.SegmentedButton.Dark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/roi_mode_freeform" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchSubtractMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:text="@string/roi_erase_holes"
                android:textColor="@color/viewer_on_dark"
                app:thumbTint="@color/sky_bright"
                app:trackTint="@color/viewer_chip_off" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveRoi"
                style="@style/Widget.IndicVision.Button.Cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/save_roi" />
        </LinearLayout>
    </HorizontalScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
