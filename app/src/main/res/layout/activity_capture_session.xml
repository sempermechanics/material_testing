<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/captureSessionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/text_primary">

    <TextureView
        android:id="@+id/capturePreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#99000000">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarCaptureSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:title="@string/capture_session_title"
            app:navigationIcon="@drawable/ic_close"
            app:titleTextColor="@color/text_on_primary" />

        <TextView
            android:id="@+id/tvCaptureStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_on_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvCaptureProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/sky_bright"
            android:textSize="13sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCaptureStart"
        style="@style/Widget.Semper.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:text="@string/capture_start_recording"
        android:visibility="gone" />
</FrameLayout>
