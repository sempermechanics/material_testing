<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viewer_canvas">

    <FrameLayout
        android:id="@+id/topBarHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_viewer_panel"
            android:paddingHorizontal="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <Spinner
                android:id="@+id/spinnerResultType"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner_glass"
                android:paddingHorizontal="12dp"
                android:popupBackground="@color/viewer_glass"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/toggleInspect"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ToggleButton
                android:id="@+id/toggleInspect"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_chip_toggle"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:textAllCaps="false"
                android:textColor="@color/viewer_on_dark"
                android:textOff="Inspect"
                android:textOn="Inspect"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnInputCoords"
                app:layout_constraintStart_toEndOf="@id/spinnerResultType"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInputCoords"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="18dp"
                android:text="X, Y"
                android:textAllCaps="false"
                android:textColor="@color/viewer_on_dark"
                android:textStyle="bold"
                app:backgroundTint="@color/sky_primary"
                app:cornerRadius="22dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/toggleMaxMin"
                app:layout_constraintStart_toEndOf="@id/toggleInspect"
                app:layout_constraintTop_toTopOf="parent"
                app:rippleColor="#33FFFFFF" />

            <ToggleButton
                android:id="@+id/toggleMaxMin"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_chip_toggle"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:textAllCaps="false"
                android:textColor="@color/viewer_on_dark"
                android:textOff="Max/Min"
                android:textOn="Max/Min"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnInputCoords"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!-- Fixed color-scale legend band: sits between the top controls and the
         image so it never overlaps the heatmap. -->
    <LinearLayout
        android:id="@+id/layoutColorScale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBarHost"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_viewer_panel"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/tvScaleMin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="Min: 0.0"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/viewColorScale"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_weight="1"
            android:background="@drawable/jet_gradient_horizontal" />

        <TextView
            android:id="@+id/tvScaleMax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Max: 0.0"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Image area: fills the space between the legend band and the scrubber. -->
    <RelativeLayout
        android:id="@+id/zoomContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutScrubber"
        android:layout_below="@id/layoutColorScale">

        <com.rafad.indicvisiondic.TouchImageView
            android:id="@+id/imgBaseResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="matrix" />

        <ImageView
            android:id="@+id/imgHeatmapOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.7"
            android:scaleType="matrix" />

        <com.rafad.indicvisiondic.InspectOverlayView
            android:id="@+id/glassShield"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layoutScrubber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@android:color/transparent"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_viewer_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp">

            <ImageButton
                android:id="@+id/btnPrevFrame"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_nav_chip"
                android:contentDescription="@string/prev_frame"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_prev"
                app:tint="@color/viewer_on_dark" />

            <TextView
                android:id="@+id/tvFrameCounter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Frame: 1 / 1"
                android:textColor="@color/viewer_on_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnNextFrame"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_nav_chip"
                android:contentDescription="@string/next_frame"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_next"
                app:tint="@color/viewer_on_dark" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutExport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="100dp"
        android:background="@drawable/bg_viewer_panel"
        android:elevation="4dp"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <Spinner
            android:id="@+id/spinnerExportType"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_spinner_glass"
            android:paddingHorizontal="12dp"
            android:popupBackground="@color/viewer_glass" />

        <ImageButton
            android:id="@+id/btnExportExecute"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_pill_accent"
            android:contentDescription="@string/export_execute"
            android:src="@android:drawable/ic_menu_save"
            app:tint="@color/viewer_on_dark" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardInspectorHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/layoutScrubber"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/viewer_glass"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp">

        <TextView
            android:id="@+id/tvInspectorData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:text="Tap image to inspect"
            android:textColor="@color/sky_bright"
            android:textSize="14sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardMaxMinHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/cardInspectorHud"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="2dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/viewer_glass"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp">

        <TextView
            android:id="@+id/tvMaxMinData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:text="Max: --\nMin: --"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

</RelativeLayout>