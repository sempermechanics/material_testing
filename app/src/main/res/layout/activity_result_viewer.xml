<?xml version="1.0" encoding="utf-8"?>
<!-- Light Semper chrome around the heatmap; figure stays uninverted. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_muted"
    tools:ignore="Overdraw">

    <RelativeLayout
        android:id="@+id/zoomContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:forceDarkAllowed="false">

        <com.sempermechanics.semper.ui.viewer.inspect.TouchImageView
            android:id="@+id/imgBaseResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="matrix" />

        <ImageView
            android:id="@+id/imgHeatmapOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.7"
            android:clickable="false"
            android:contentDescription="@string/viewer_heatmap_overlay_desc"
            android:focusable="false"
            android:outlineProvider="bounds"
            android:scaleType="matrix" />

        <com.sempermechanics.semper.ui.viewer.inspect.InspectOverlayView
            android:id="@+id/glassShield"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/summaryLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/viewer_canvas"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone">

            <com.sempermechanics.semper.ui.viewer.inspect.TouchImageView
                android:id="@+id/imgSummary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/summary_title"
                android:scaleType="matrix" />
        </FrameLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/viewerTopStack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <include
            android:id="@+id/transferBannerRoot"
            layout="@layout/view_transfer_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/chromeTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:forceDarkAllowed="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="6dp">

            <!-- 48dp buttons with the 40dp puck inset (bg_chrome_ghost_touch): the bar's
                 padding and gaps are 4dp less on each side, so it looks as it did. -->
            <ImageButton
                android:id="@+id/btnViewerBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_chrome_ghost_touch"
                android:contentDescription="@string/viewer_back_desc"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_prev"
                app:tint="@color/viewer_chrome_text" />

            <TextView
                android:id="@+id/tvFinding"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="@color/viewer_text_halo"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/results_title"
                android:textColor="@color/viewer_chrome_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnViewerSettingsInfo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chrome_ghost_touch"
                android:contentDescription="@string/viewer_details_desc"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_info_min"
                app:tint="@color/viewer_chrome_text" />

            <ImageButton
                android:id="@+id/btnViewerHome"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chrome_ghost_touch"
                android:contentDescription="@string/viewer_home_desc"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home"
                app:tint="@color/viewer_chrome_text" />

            <ImageButton
                android:id="@+id/btnViewerShare"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_chrome_ghost_touch"
                android:contentDescription="@string/action_share"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_share"
                app:tint="@color/viewer_chrome_text" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFieldFab"
            style="@style/Widget.Semper.SegmentedButton.ViewerImmersive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:checkable="false"
            android:text="@string/field_u"
            app:icon="@drawable/ic_expand_more"
            app:iconGravity="end"
            app:iconSize="16dp"
            app:iconPadding="2dp"
            app:iconTint="@color/field_pill_text"
            android:contentDescription="@string/viewer_field_fab_desc" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutColorScale"
        android:layout_width="wrap_content"
        android:layout_height="280dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:clickable="true"
        android:focusable="true"
        android:forceDarkAllowed="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/tvScaleMax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_probe_chip"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/scale_label_pending"
            android:textColor="@color/viewer_probe_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/viewColorScale"
            android:layout_width="20dp"
            android:layout_height="0dp"
            android:layout_marginVertical="8dp"
            android:layout_weight="1"
            android:forceDarkAllowed="false" />

        <TextView
            android:id="@+id/tvScaleMin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_probe_chip"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/scale_label_pending"
            android:textColor="@color/viewer_probe_ink"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom edge: the summary's progress pill sits just above the scrubber.
         The chrome fades layoutScrubber INVISIBLE, never GONE, so the pill keeps
         its place while the bars are hidden. -->
    <LinearLayout
        android:id="@+id/viewerBottomStack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- While the summary builds: "Building summary · 3 of 5", a close button and a
             thin bar (ViewerSummaryController). Not part of the auto-hiding chrome: it
             is progress the user is waiting on. Light surface; force dark inverts it. -->
        <LinearLayout
            android:id="@+id/summaryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_summary_pill"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="2dp"
            android:paddingEnd="2dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSummaryStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:paddingVertical="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    tools:text="Building summary · 3 of 5" />

                <ImageButton
                    android:id="@+id/btnSummaryCancel"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/summary_cancel_desc"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/text_secondary"
                    tools:visibility="visible" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="10dp"
                android:indeterminate="true"
                android:max="100"
                app:indicatorColor="@color/sky_primary"
                app:trackColor="@color/sky_container"
                app:trackCornerRadius="2dp"
                app:trackThickness="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutScrubber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- forceDarkAllowed=false on both frame buttons: their night tokens are
                 already dark-tuned, as the top bar's are; darkened again, the rim
                 vanished on the dark page (readiness AE1V-021). -->
            <ImageButton
                android:id="@+id/btnPrevFrame"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_chrome_ghost"
                android:forceDarkAllowed="false"
                android:contentDescription="@string/prev_frame"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_prev"
                app:tint="@color/viewer_chrome_text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/tvFrameCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:shadowColor="@color/viewer_text_halo"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:singleLine="true"
                    android:text="@string/frame_1_1"
                    android:textColor="@color/viewer_chrome_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutFrameJump"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etFrameNumber"
                        style="@style/Widget.Semper.InlineValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="center"
                        android:hint="@string/frame_number_hint"
                        android:imeOptions="actionGo"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="4"
                        android:paddingVertical="1dp"
                        android:shadowColor="@color/viewer_text_halo"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        android:textColor="@color/viewer_chrome_text"
                        android:textColorHint="@color/viewer_chrome_muted"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFrameTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:shadowColor="@color/viewer_text_halo"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        android:textColor="@color/viewer_chrome_muted"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNextFrame"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_chrome_ghost"
                android:forceDarkAllowed="false"
                android:contentDescription="@string/next_frame"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_next"
                app:tint="@color/viewer_chrome_text" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvProbeReadout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="200dp"
        android:background="@drawable/bg_probe_chip"
        android:fontFeatureSettings="tnum"
        android:forceDarkAllowed="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="@color/viewer_probe_ink"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvStatsCaption"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- "Opening … · N frames" while the first frame loads (ViewerCaptions.showOpening):
         shown only past 300 ms, gone once that frame draws. Floats over the
         canvas; nothing else in the layout moves for it. -->
    <LinearLayout
        android:id="@+id/viewerOpening"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="@dimen/space_24"
        android:background="@drawable/bg_pill_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingVertical="@dimen/space_8"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/viewerOpeningSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_8"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/viewer_chrome_text"
            app:indicatorSize="16dp"
            app:trackThickness="2dp" />

        <TextView
            android:id="@+id/tvViewerOpening"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/viewer_chrome_text"
            android:textSize="13sp"
            tools:text="Opening steel_00 · 40 frames" />
    </LinearLayout>

</FrameLayout>
