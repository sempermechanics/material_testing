<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#1E1E24">

    <Spinner
        android:id="@+id/spinnerResultType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@android:drawable/btn_dropdown" />

    <FrameLayout
        android:id="@+id/zoomContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/spinnerResultType">

        <ToggleButton
            android:id="@+id/toggleInspect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn="INSPECT: ON"
            android:textOff="INSPECT: OFF"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:layout_margin="8dp" />

        <com.rafad.indicvisiondic.TouchImageView
            android:id="@+id/imgBaseResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="matrix" />

        <ImageView
            android:id="@+id/imgHeatmapOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="matrix"
            android:alpha="0.7" />
        <com.rafad.indicvisiondic.InspectOverlayView
            android:id="@+id/glassShield"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="200dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="10dp"
            android:background="#99000000"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tvScaleMax"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Max\n\n\n\nMin"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center_vertical"/>

            <View
                android:id="@+id/viewColorScale"
                android:layout_width="20dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:background="@drawable/jet_gradient_bar"/>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnExportCsv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💾 CSV"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnExportImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷 Image"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/cardInspectorHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="100dp"
        app:cardBackgroundColor="#CC1E1E24"
        app:cardCornerRadius="8dp"
        app:cardElevation="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvInspectorData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Tap image to inspect"
            android:textColor="#00FF00"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="monospace"/>
    </androidx.cardview.widget.CardView>
</RelativeLayout>