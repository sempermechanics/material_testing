<?xml version="1.0" encoding="utf-8"?>
<!-- Photos-minimal viewer: full-bleed figure; edge chrome overlays the heatmap. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viewer_immersive_canvas"
    android:forceDarkAllowed="false"
    tools:targetApi="29">

    <!-- Figure fills the screen. forceDarkAllowed=false keeps jet uninverted. -->
    <RelativeLayout
        android:id="@+id/zoomContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:forceDarkAllowed="false"
        tools:targetApi="29">

        <com.indicvision.semper.ui.viewer.TouchImageView
            android:id="@+id/imgBaseResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="matrix" />

        <ImageView
            android:id="@+id/imgHeatmapOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.7"
            android:contentDescription="@string/viewer_heatmap_overlay_desc"
            android:outlineProvider="bounds"
            android:scaleType="matrix" />

        <com.indicvision.semper.ui.viewer.InspectOverlayView
            android:id="@+id/glassShield"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/summaryLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0B1220"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgSummary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/summary_title"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:id="@+id/summaryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_probe_chip"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <ProgressBar
                    android:id="@+id/progressSummary"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:max="100" />

                <TextView
                    android:id="@+id/tvSummaryStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSummaryCancel"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/action_cancel"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </RelativeLayout>

    <!-- Auto-hiding edge chrome (Photos pattern). Not toggled by image tap — probe owns tap. -->
    <LinearLayout
        android:id="@+id/chromeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:forceDarkAllowed="false"
        android:orientation="vertical"
        tools:targetApi="29">

        <LinearLayout
            android:id="@+id/topBarHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <ImageButton
                android:id="@+id/btnViewerBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chrome_ghost"
                android:contentDescription="@string/viewer_back_desc"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_prev"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvFinding"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/results_title"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnViewerSettingsInfo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chrome_ghost"
                android:contentDescription="@string/viewer_details_desc"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_info_min"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnViewerShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chrome_ghost"
                android:contentDescription="@string/action_share"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_share"
                app:tint="#FFFFFF" />

            <!-- Kept for code / Home from the peek sheet; not shown in edge chrome. -->
            <ImageButton
                android:id="@+id/btnViewerHome"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@string/viewer_home_desc"
                android:src="@drawable/ic_home"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Hairline colour scale: labels = this frame's min/max. -->
        <LinearLayout
            android:id="@+id/layoutColorScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:clickable="true"
            android:focusable="true"
            android:forceDarkAllowed="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            tools:targetApi="29">

            <TextView
                android:id="@+id/tvScaleMin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#80000000"
                android:shadowRadius="2"
                android:text="@string/min_0_0"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/viewColorScale"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:background="@drawable/jet_gradient_horizontal" />

            <TextView
                android:id="@+id/tvScaleMax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#80000000"
                android:shadowRadius="2"
                android:text="@string/max_0_0"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fieldToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rbFieldU"
                style="@style/Widget.Semper.SegmentedButton.ViewerImmersive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:checkable="true"
                android:checked="true"
                android:minWidth="0dp"
                android:text="@string/field_u" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rbFieldV"
                style="@style/Widget.Semper.SegmentedButton.ViewerImmersive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:checkable="true"
                android:minWidth="0dp"
                android:text="@string/field_v" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rbFieldExx"
                style="@style/Widget.Semper.SegmentedButton.ViewerImmersive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:checkable="true"
                android:minWidth="0dp"
                android:text="@string/field_exx" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rbFieldEyy"
                style="@style/Widget.Semper.SegmentedButton.ViewerImmersive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:checkable="true"
                android:minWidth="0dp"
                android:text="@string/field_eyy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rbFieldExy"
                style="@style/Widget.Semper.SegmentedButton.ViewerImmersive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:checkable="true"
                android:minWidth="0dp"
                android:text="@string/field_exy" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutScrubber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <ImageButton
                android:id="@+id/btnPrevFrame"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chrome_ghost"
                android:contentDescription="@string/prev_frame"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_prev"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/tvFrameCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:shadowColor="#80000000"
                    android:shadowRadius="2"
                    android:singleLine="true"
                    android:text="@string/frame_1_1"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutFrameJump"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etFrameNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="center"
                        android:hint="@string/frame_number_hint"
                        android:imeOptions="actionGo"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="4"
                        android:minWidth="28dp"
                        android:paddingVertical="1dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#99FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFrameTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#CCFFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNextFrame"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chrome_ghost"
                android:contentDescription="@string/next_frame"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_next"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvProbeReadout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="148dp"
        android:background="@drawable/bg_probe_chip"
        android:fontFamily="monospace"
        android:forceDarkAllowed="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone"
        tools:targetApi="29" />

    <!-- Populated for the peek sheet; not shown on the canvas. -->
    <TextView
        android:id="@+id/tvStatsCaption"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>
