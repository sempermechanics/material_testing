<?xml version="1.0" encoding="utf-8"?>
<!-- One of the account's phones (PhonesActivity): its model, whether the
     licence covers it, and Deactivate on a covered one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPhoneModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:text="Pixel 6" />

        <TextView
            android:id="@+id/tvPhoneStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="This phone · Activated" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPhoneDeactivate"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/phones_deactivate"
        android:textAllCaps="false"
        android:textColor="@color/sky_primary" />
</LinearLayout>
