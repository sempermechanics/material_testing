<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Metadata summary (resolution · fps · length) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/sky_container"
        android:padding="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_video"
            android:contentDescription="@string/video" />

        <TextView
            android:id="@+id/tvVideoInfo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/text"
            android:textColor="@color/sky_on_container"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Extraction mode toggle (Keyframes vs Uniform interval) -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleExtractMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:checkedButton="@+id/btnModeKeyframes"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeKeyframes"
            style="@style/Widget.Semper.SegmentedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/video_mode_keyframes" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeUniform"
            style="@style/Widget.Semper.SegmentedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/video_mode_uniform" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Extraction frame rate (used in uniform mode) -->
    <LinearLayout
        android:id="@+id/layoutFps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/extraction_frame_rate"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvFpsValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_10_fps"
                android:textColor="@color/sky_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderFps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="1"
            android:valueTo="30"
            android:stepSize="1"
            android:value="10" />
    </LinearLayout>

    <!-- Time segment -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/time_segment"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvSegmentValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_0_00_0_00"
            android:textColor="@color/sky_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.slider.RangeSlider
        android:id="@+id/rangeSegment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100" />

    <TextView
        android:id="@+id/tvEstimate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/label_0_frames"
        android:textAppearance="@style/TextAppearance.Semper.Caption" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/video_first_frame_note"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExtractFrames"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/extract_frames_title" />

</LinearLayout>
