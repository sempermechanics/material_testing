<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Metadata summary (resolution · fps · length) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/sky_container"
        android:padding="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_video"
            android:contentDescription="Video" />

        <TextView
            android:id="@+id/tvVideoInfo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="—"
            android:textColor="@color/sky_on_container"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Extraction frame rate -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Extraction frame rate"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvFpsValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10 fps"
            android:textColor="@color/sky_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderFps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="1"
        android:valueTo="30"
        android:stepSize="1"
        android:value="10" />

    <!-- Time segment -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Time segment"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvSegmentValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00 – 0:00"
            android:textColor="@color/sky_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.slider.RangeSlider
        android:id="@+id/rangeSegment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100" />

    <TextView
        android:id="@+id/tvEstimate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="≈ 0 frames"
        android:textAppearance="@style/TextAppearance.IndicVision.Caption" />
</LinearLayout>
