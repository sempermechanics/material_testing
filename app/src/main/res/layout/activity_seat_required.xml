<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/seatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_muted"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp" tools:ignore="Overdraw">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_warn_chip"
        android:contentDescription="@string/seat_title"
        android:padding="14dp"
        android:src="@android:drawable/stat_sys_warning"
        app:tint="@color/semantic_warning" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/seat_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSeatBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxWidth="300dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTakeSeat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/seat_take" />

    <ProgressBar
        android:id="@+id/progressSeat"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="10dp"
        android:indeterminateTint="@color/sky_primary"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/tvSeatBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:padding="6dp"
        android:text="@string/seat_back"
        android:textColor="@color/sky_primary"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
