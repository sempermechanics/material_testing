<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollStepSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/settingsColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Inputs summary -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/viewer_glass_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivInputsThumb"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@color/viewer_canvas"
                    android:contentDescription="@string/reference_image_preview"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvInputsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:maxLines="1"
                        android:textColor="@color/viewer_chrome_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvInputsMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/viewer_chrome_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Region of interest -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/viewer_glass_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/region_of_interest"
                        android:src="@drawable/ic_crop"
                        app:tint="@color/viewer_chrome_muted" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/region_of_interest"
                            android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                            android:textColor="@color/viewer_chrome_text" />

                        <TextView
                            android:id="@+id/tvInstruction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/viewer_chrome_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDefineRoi"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_edit" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: analysis mode — one setting, or a parameter sweep -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/viewer_glass_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/analysis_mode"
                        android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                        android:textColor="@color/viewer_chrome_text" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btnSweepInfo"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/info"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_info_min"
                        app:tint="@color/viewer_chrome_muted" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/rgAnalysisMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:checkedButton="@+id/rbModeSingle"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rbModeSingle"
                        style="@style/Widget.Semper.SegmentedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mode_single" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rbModeSweep"
                        style="@style/Widget.Semper.SegmentedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mode_sweep" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Line-cut preview: Parameter sweep only -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/lineCutPreviewCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/viewer_glass_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/line_cut_preview_heading"
                        android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                        android:textColor="@color/viewer_chrome_text" />

                    <ImageButton
                        android:id="@+id/btnLineCutInfo"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/info"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_info_min"
                        app:tint="@color/viewer_chrome_muted" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/rgLineCutAxis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:checkedButton="@+id/rbAxisX"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rbAxisX"
                        style="@style/Widget.Semper.SegmentedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/axis_x" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rbAxisY"
                        style="@style/Widget.Semper.SegmentedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/axis_y" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.indicvision.semper.ui.analysis.LineCutPreviewView
                    android:id="@+id/lineCutPreview"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: Analysis parameters (dedicated settings page) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/advancedParamsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/viewer_glass_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/advancedParamsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_tune"
                        android:contentDescription="@string/parameters" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/advanced_parameters"
                        android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                        android:textColor="@color/viewer_chrome_text" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btnPasteParams"
                        style="@style/Widget.Semper.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="@string/action_paste_params"
                        android:visibility="gone"
                        app:chipIcon="@drawable/ic_content_paste"
                        tools:visibility="visible" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btnAdvancedReset"
                        style="@style/Widget.Semper.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="@string/action_reset"
                        app:chipIcon="@drawable/ic_reset" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/advancedParamsBody"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:visibility="visible">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/viewer_glass_stroke" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/subset_size"
                            android:textColor="@color/viewer_chrome_text"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnSubsetInfo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/info"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_info_min"
                            app:tint="@color/viewer_chrome_muted" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />
                        <EditText
                            android:id="@+id/tvSubsetValue"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="end"
                            android:hint="@string/subset_size"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="3"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:text="@string/label_41"
                            android:textColor="@color/sky_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/scale_unit_px"
                            android:textColor="@color/sky_primary"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/etSubsetSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="15"
                        android:valueTo="121"
                        android:stepSize="2"
                        android:value="41" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/step_size_density"
                            android:textColor="@color/viewer_chrome_text"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnStepInfo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/info"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_info_min"
                            app:tint="@color/viewer_chrome_muted" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />
                        <EditText
                            android:id="@+id/tvStepValue"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="end"
                            android:hint="@string/step_size_density"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="3"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:text="@string/label_5"
                            android:textColor="@color/sky_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/scale_unit_px"
                            android:textColor="@color/sky_primary"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/etStepSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="1"
                        android:valueTo="30"
                        android:stepSize="1"
                        android:value="5" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/strain_window"
                            android:textColor="@color/viewer_chrome_text"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnStrainInfo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/info"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_info_min"
                            app:tint="@color/viewer_chrome_muted" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />
                        <EditText
                            android:id="@+id/tvStrainValue"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="end"
                            android:hint="@string/strain_window"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="3"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:text="@string/label_15"
                            android:textColor="@color/sky_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/scale_unit_px"
                            android:textColor="@color/sky_primary"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/etStrainWindow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="5"
                        android:valueTo="101"
                        android:stepSize="2"
                        android:value="15" />



                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/sub_pixel_interpolation_kernel"
                        android:textColor="@color/viewer_chrome_text"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/rgInterpolator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:checkedButton="@+id/rbBicubic">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rbBicubic"
                            style="@style/Widget.Semper.SegmentedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/label_4_4_bicubic" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rbKeys"
                            style="@style/Widget.Semper.SegmentedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/label_6_6_keys" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Results chrome (Compute is in bottomNav) -->

        <TextView
            android:id="@+id/tvStaticResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/result"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/viewer_chrome_text"
            android:textAlignment="center"
            android:layout_marginTop="12dp"
            android:paddingBottom="20dp" />
    </LinearLayout>
</ScrollView>
