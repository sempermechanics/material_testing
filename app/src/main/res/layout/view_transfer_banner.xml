<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/transferBannerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:elevation="4dp"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnTransferPrev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/transfer_banner_prev"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_prev"
            android:visibility="gone"
            app:tint="@color/text_primary"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/tvTransferTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Export my data" />

            <TextView
                android:id="@+id/tvTransferStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="42%" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/transferProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:indicatorColor="@color/sky_primary"
                app:trackColor="@color/surface_muted"
                app:trackThickness="4dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnTransferNext"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/transfer_banner_next"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_next"
            android:visibility="gone"
            app:tint="@color/text_primary"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/btnTransferCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:text="@string/action_cancel"
            android:textColor="@color/sky_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTransferPage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="2 / 3"
        tools:visibility="visible" />
</LinearLayout>
