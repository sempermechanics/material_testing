<?xml version="1.0" encoding="utf-8"?>
<!-- Home's + asks this first (TestTypeSheet). Drawn like Semper's other sheets
     (sheet_share.xml): a title, then flat rows split by hairlines. 2D DIC, which
     is Semper's analysis, comes first; the two lab tests follow. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="34dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@color/surface_outline" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/test_type_title"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/divider_hairline"
        android:orientation="vertical"
        android:showDividers="middle">

        <LinearLayout
            android:id="@+id/btnTestDic2d"
            style="@style/Widget.Semper.ShareRow"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Semper.TestTypeTitle"
                android:text="@string/test_type_dic2d" />

            <TextView
                style="@style/Widget.Semper.TestTypeSub"
                android:text="@string/test_type_sub_dic2d" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnTestTensile"
            style="@style/Widget.Semper.ShareRow"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Semper.TestTypeTitle"
                android:text="@string/test_type_tensile" />

            <TextView
                style="@style/Widget.Semper.TestTypeSub"
                android:text="@string/test_type_sub_loads" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnTestBending"
            style="@style/Widget.Semper.ShareRow"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Semper.TestTypeTitle"
                android:text="@string/test_type_bending" />

            <TextView
                style="@style/Widget.Semper.TestTypeSub"
                android:text="@string/test_type_sub_flexural" />
        </LinearLayout>
    </LinearLayout>

    <!-- No photos yet: a bundled example set instead (ADR-031). Hidden when
         the caller passes no handler. -->
    <TextView
        android:id="@+id/btnTryExample"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="?attr/selectableItemBackground"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:text="@string/examples_try_from_sheet"
        android:textColor="@color/sky_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
