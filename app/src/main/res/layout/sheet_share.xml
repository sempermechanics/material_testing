<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="34dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@color/surface_outline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_share"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSharePosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="frame 1 of 5" />
    </LinearLayout>

    <!-- Flat rows split by hairlines; LinearLayout skips the divider of a gone
         row (a sweep's Animations), so no two hairlines ever meet. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/divider_hairline"
        android:orientation="vertical"
        android:showDividers="middle">

        <LinearLayout
            android:id="@+id/rowSharePhoto"
            style="@style/Widget.Semper.ShareRow">

            <ImageView
                style="@style/Widget.Semper.ShareRowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_photo_share" />

            <TextView
                style="@style/Widget.Semper.ShareRowTitle"
                android:text="@string/share_photo" />

            <TextView
                style="@style/Widget.Semper.ShareRowType"
                android:text="@string/share_type_png" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowShareAllPhotos"
            style="@style/Widget.Semper.ShareRow">

            <ImageView
                style="@style/Widget.Semper.ShareRowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_photos_share" />

            <TextView
                style="@style/Widget.Semper.ShareRowTitle"
                android:text="@string/share_all_photos" />

            <TextView
                android:id="@+id/tvShareAllPhotosType"
                style="@style/Widget.Semper.ShareRowType"
                tools:text="5 PNG" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowShareAnimations"
            style="@style/Widget.Semper.ShareRow">

            <ImageView
                style="@style/Widget.Semper.ShareRowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_photos_share" />

            <TextView
                style="@style/Widget.Semper.ShareRowTitle"
                android:text="@string/share_animations" />

            <TextView
                android:id="@+id/tvShareAnimationsType"
                style="@style/Widget.Semper.ShareRowType"
                tools:text="5 GIF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowSharePdf"
            style="@style/Widget.Semper.ShareRow">

            <ImageView
                style="@style/Widget.Semper.ShareRowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_doc_share" />

            <TextView
                style="@style/Widget.Semper.ShareRowTitle"
                android:text="@string/share_pdf" />

            <TextView
                style="@style/Widget.Semper.ShareRowType"
                android:text="@string/share_type_pdf" />
        </LinearLayout>

        <!-- Material Testing: a tensile or bending test with loads (ShareCenter). -->
        <LinearLayout
            android:id="@+id/rowShareLabReport"
            style="@style/Widget.Semper.ShareRow"
            android:visibility="gone">

            <ImageView
                style="@style/Widget.Semper.ShareRowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_doc_share" />

            <TextView
                style="@style/Widget.Semper.ShareRowTitle"
                android:text="@string/share_lab_report" />

            <TextView
                style="@style/Widget.Semper.ShareRowType"
                android:text="@string/share_type_pdf" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowShareCsv"
            style="@style/Widget.Semper.ShareRow">

            <ImageView
                style="@style/Widget.Semper.ShareRowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_table_share" />

            <TextView
                style="@style/Widget.Semper.ShareRowTitle"
                android:text="@string/share_csv" />

            <TextView
                style="@style/Widget.Semper.ShareRowType"
                android:text="@string/share_type_csv" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowShareZip"
            style="@style/Widget.Semper.ShareRow">

            <ImageView
                style="@style/Widget.Semper.ShareRowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_zip_share"
                app:tint="@color/sky_primary" />

            <TextView
                style="@style/Widget.Semper.ShareRowTitle"
                android:text="@string/share_zip" />

            <TextView
                style="@style/Widget.Semper.ShareRowType"
                android:text="@string/share_type_zip" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
