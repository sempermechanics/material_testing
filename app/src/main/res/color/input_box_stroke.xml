<?xml version="1.0" encoding="utf-8"?>
<!-- Unfocused uses surface_outline (a light hairline) so force-dark inverts it
     to a visible rim. sky_primary is too dark unfocused and disappears at night. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/sky_primary" android:state_focused="true" />
    <item android:color="@color/surface_outline" />
</selector>
