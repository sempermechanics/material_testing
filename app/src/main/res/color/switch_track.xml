<?xml version="1.0" encoding="utf-8"?>
<!-- Switch track. Off is the strong outline, 3.4:1 on surface_muted, so an off
     switch is still seen as a control (Material's 38% on-surface track was
     1.89:1, readiness AE1-106); on keeps Material's 54% brand track. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.38" android:color="@color/outline_strong" android:state_enabled="false" />
    <item android:alpha="0.54" android:color="@color/sky_primary" android:state_checked="true" />
    <item android:color="@color/outline_strong" />
</selector>
