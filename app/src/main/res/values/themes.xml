<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================= -->
    <!--  Application theme — Deep Sky Blue & White                    -->
    <!-- ============================================================= -->
    <style name="Theme.IndicVisionDIC" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/sky_primary</item>
        <item name="colorPrimaryVariant">@color/sky_primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/sky_bright</item>
        <item name="colorSecondaryVariant">@color/sky_primary_dark</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>

        <!-- Surfaces / background -->
        <item name="android:colorBackground">@color/surface_muted</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/semantic_danger</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/surface_muted</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Shapes: soft, consistent rounding across all Material components -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.IndicVision.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.IndicVision.Medium</item>

        <!-- Default component styles applied app-wide -->
        <item name="materialButtonStyle">@style/Widget.IndicVision.Button</item>
        <item name="materialCardViewStyle">@style/Widget.IndicVision.Card</item>
        <item name="sliderStyle">@style/Widget.IndicVision.Slider</item>

        <!-- Subtle, professional screen transitions (enabled per-activity) -->
        <item name="android:windowAnimationStyle">@style/Animation.IndicVision.Activity</item>
    </style>

    <!-- Splash window matches the light layout so the first frame doesn't flash -->
    <style name="Theme.IndicVisionDIC.Splash" parent="Theme.IndicVisionDIC">
        <item name="android:statusBarColor">@color/surface_muted</item>
        <item name="android:windowBackground">@color/surface_muted</item>
    </style>
</resources>
