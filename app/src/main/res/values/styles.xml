<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================= -->
    <!--  Shape appearances                                            -->
    <!-- ============================================================= -->
    <style name="ShapeAppearance.Semper.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.Semper.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="Widget.Semper" parent="android:Widget" />

    <!-- ============================================================= -->
    <!--  Buttons                                                      -->
    <!-- ============================================================= -->
    <!-- Primary filled action (default via theme's materialButtonStyle) -->
    <style name="Widget.Semper.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/sky_primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- Tonal / secondary: light sky container, dark text -->

    <!-- Outlined: quiet actions -->
    <style name="Widget.Semper.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/sky_primary</item>
        <item name="android:textColor">@color/sky_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">#220288D1</item>
    </style>

    <!-- Destructive (log out, cancel) -->
    <style name="Widget.Semper.Button.Text.Danger" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/semantic_danger</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">#22E53935</item>
    </style>

    <!-- Prominent success CTA (Compute) -->
    <style name="Widget.Semper.Button.Cta">
        <item name="backgroundTint">@color/sky_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- ============================================================= -->
    <!--  Cards                                                        -->
    <!-- ============================================================= -->
    <style name="Widget.Semper.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/surface_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <!-- ============================================================= -->
    <!--  Sliders / segmented toggles                                  -->
    <!-- ============================================================= -->
    <style name="Widget.Semper.Slider" parent="Widget.MaterialComponents.Slider">
        <item name="trackColorActive">@color/sky_primary</item>
        <item name="trackColorInactive">@color/sky_container</item>
        <item name="thumbColor">@color/sky_primary</item>
        <item name="haloColor">#330288D1</item>
        <item name="tickColorActive">#66FFFFFF</item>
        <item name="tickColorInactive">#660288D1</item>
        <item name="labelStyle">@style/Widget.Semper.Slider.Tooltip</item>
    </style>

    <style name="Widget.Semper.Slider.Tooltip" parent="Widget.MaterialComponents.Tooltip">
        <item name="backgroundTint">@color/sky_primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
    </style>

    <!-- Segmented button group (replaces radio groups) -->
    <style name="Widget.Semper.SegmentedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/surface_outline</item>
        <item name="android:textColor">@color/segmented_text</item>
        <item name="backgroundTint">@color/segmented_bg</item>
        <item name="rippleColor">#220288D1</item>
    </style>

    <!-- Compact field row in the result viewer. -->
    <style name="Widget.Semper.SegmentedButton.Viewer" parent="Widget.Semper.SegmentedButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- Floating glass field pills over the immersive heatmap (wireframe: rounded-full).
         Shape and colour are the immersive treatment — stadium, no stroke, translucent
         fill that inverts to solid when checked. Metrics are deliberately the LARGER
         touch sizes the viewer settled on (40dp / 14sp), not the original compact
         30dp / 11sp: the shape language changes, the tap target does not. -->
    <style name="Widget.Semper.SegmentedButton.ViewerImmersive" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="cornerRadius">999dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">@color/field_pill_bg</item>
        <item name="android:textColor">@color/field_pill_text</item>
        <item name="rippleColor">@color/viewer_glass_ripple</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- Peek sheet home action: soft glass pill on dark. -->
    <style name="Widget.Semper.Button.ViewerPeekHome" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/viewer_peek_text</item>
        <item name="android:minHeight">44dp</item>
        <item name="backgroundTint">@color/viewer_glass_fill</item>
        <item name="strokeColor">@color/viewer_glass_stroke</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="rippleColor">@color/viewer_glass_ripple</item>
        <item name="cornerRadius">999dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="ShapeAppearance.Semper.ViewerPeek" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="Widget.Semper.ViewerPeekSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Semper.ViewerPeek</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>

    <style name="ThemeOverlay.Semper.ViewerPeekSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Semper.ViewerPeekSheet</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorOnSurface">@color/viewer_peek_text</item>
        <!-- Deliberately does NOT tint the navigation bar. 19e5209 could set it to
             viewer_peek_scrim because that scrim was always dark, so the system's
             white nav icons stayed legible. This scrim is now light in the light
             theme, and the matching android:windowLightNavigationBar needs API 27
             while minSdk is 24 — on 24-26 that would leave white icons on a white
             bar. Inheriting the activity's own (already correct) system-bar
             handling avoids the whole problem on every API level. -->
    </style>

    <!-- Segmented chips on the dark ROI draw toolbar -->
    <style name="Widget.Semper.SegmentedButton.Dark" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/viewer_on_dark</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">20dp</item>
        <item name="backgroundTint">@color/chip_toggle_bg_dark</item>
        <item name="strokeColor">@color/surface_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- Small outlined assist chip (Reset / Paste in advanced params) -->
    <style name="Widget.Semper.Chip.Assist" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="chipStrokeColor">@color/sky_primary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/sky_primary</item>
        <item name="chipIconTint">@color/sky_primary</item>
        <item name="chipIconSize">16dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="rippleColor">#220288D1</item>
    </style>

    <!-- ============================================================= -->
    <!--  Typography                                                   -->
    <!-- ============================================================= -->

    <style name="TextAppearance.Semper.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Semper.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Numbered step badge (the "1", "2", "3" pills) -->

    <!-- ============================================================= -->
    <!--  Motion: subtle shared-axis-style activity transition         -->
    <!-- ============================================================= -->
    <style name="Animation.Semper.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out_scale</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in_scale</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>
