<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================= -->
    <!--  Shape appearances                                            -->
    <!-- ============================================================= -->
    <style name="ShapeAppearance.IndicVision.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.IndicVision.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="Widget.IndicVision" parent="android:Widget" />

    <!-- ============================================================= -->
    <!--  Buttons                                                      -->
    <!-- ============================================================= -->
    <!-- Primary filled action (default via theme's materialButtonStyle) -->
    <style name="Widget.IndicVision.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/sky_primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- Tonal / secondary: light sky container, dark text -->
    <style name="Widget.IndicVision.Button.Tonal">
        <item name="backgroundTint">@color/sky_container</item>
        <item name="android:textColor">@color/sky_on_container</item>
        <item name="rippleColor">#330288D1</item>
    </style>

    <!-- Outlined: quiet actions -->
    <style name="Widget.IndicVision.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/sky_primary</item>
        <item name="android:textColor">@color/sky_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">#220288D1</item>
    </style>

    <!-- Destructive (log out, cancel) -->
    <style name="Widget.IndicVision.Button.Text.Danger" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/semantic_danger</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">#22E53935</item>
    </style>

    <!-- Prominent success CTA (Compute) -->
    <style name="Widget.IndicVision.Button.Cta">
        <item name="backgroundTint">@color/sky_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- ============================================================= -->
    <!--  Cards                                                        -->
    <!-- ============================================================= -->
    <style name="Widget.IndicVision.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/surface_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <!-- ============================================================= -->
    <!--  Sliders / segmented toggles                                  -->
    <!-- ============================================================= -->
    <style name="Widget.IndicVision.Slider" parent="Widget.MaterialComponents.Slider">
        <item name="trackColorActive">@color/sky_primary</item>
        <item name="trackColorInactive">@color/sky_container</item>
        <item name="thumbColor">@color/sky_primary</item>
        <item name="haloColor">#330288D1</item>
        <item name="tickColorActive">#66FFFFFF</item>
        <item name="tickColorInactive">#660288D1</item>
        <item name="labelStyle">@style/Widget.IndicVision.Slider.Tooltip</item>
    </style>

    <style name="Widget.IndicVision.Slider.Tooltip" parent="Widget.MaterialComponents.Tooltip">
        <item name="backgroundTint">@color/sky_primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
    </style>

    <!-- Segmented button group (replaces radio groups) -->
    <style name="Widget.IndicVision.SegmentedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/surface_outline</item>
        <item name="android:textColor">@color/segmented_text</item>
        <item name="backgroundTint">@color/segmented_bg</item>
        <item name="rippleColor">#220288D1</item>
    </style>

    <!-- ============================================================= -->
    <!--  Typography                                                   -->
    <!-- ============================================================= -->
    <style name="TextAppearance.IndicVision.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.IndicVision.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.IndicVision.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Numbered step badge (the "1", "2", "3" pills) -->
    <style name="Widget.IndicVision.StepBadge">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/bg_step_badge</item>
    </style>

    <!-- ============================================================= -->
    <!--  Motion: subtle shared-axis-style activity transition         -->
    <!-- ============================================================= -->
    <style name="Animation.IndicVision.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out_scale</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in_scale</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>
