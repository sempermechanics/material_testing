<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================= -->
    <!--  Semper Design System — "Deep Sky Blue & White"          -->
    <!--  Single source of truth for color. Prefer theme attributes    -->
    <!--  (?attr/colorPrimary, ?attr/colorSurface) in new layouts;     -->
    <!--  reference these names only when an attr doesn't fit.          -->
    <!-- ============================================================= -->

    <!-- Login / splash / PDF wordmark. Night inverts only the charcoal ink. -->
    <color name="wordmark_ink">#161618</color>
    <color name="wordmark_dic">#00A9A6</color>

    <!-- Brand: deep sky blue ramp -->
    <color name="sky_primary">#0288D1</color>          <!-- primary actions, headers -->
    <color name="sky_primary_dark">#0277BD</color>     <!-- status bar / pressed -->
    <color name="sky_bright">#00BFFF</color>           <!-- accent, active states -->
    <color name="sky_container">#E1F5FE</color>        <!-- tonal surfaces, chips -->
    <color name="sky_on_container">#014A72</color>     <!-- text on sky_container -->

    <!-- Neutrals / surfaces -->
    <color name="surface">#FFFFFF</color>
    <color name="surface_muted">#F4F9FC</color>        <!-- app background (blue-tinted white) -->
    <color name="surface_outline">#D6E4EC</color>      <!-- card strokes, dividers -->

    <!-- Text -->
    <color name="text_primary">#152430</color>         <!-- slate near-black -->
    <color name="text_secondary">#5B6B7A</color>       <!-- captions, hints -->
    <color name="text_on_primary">#FFFFFF</color>

    <!-- Semantic -->
    <color name="semantic_success">#4CAF50</color>
    <color name="semantic_danger">#E53935</color>
    <color name="semantic_warning">#F5A623</color>

    <!-- Result viewer: dark canvas so heatmaps stay vivid, with translucent
         glass controls on top -->
    <color name="viewer_canvas">#F4F9FC</color> <!-- light: matches app background -->
    <color name="viewer_glass">#F0FFFFFF</color>
    <color name="viewer_chip_off">#FFFFFF</color>
    <color name="viewer_on_dark">#152430</color> <!-- now "on viewer panel"; light theme -->

    <!-- Immersive viewer chrome: translucent glass pucks floating over a full-bleed
         figure, no opaque bars and no elevation (see values-night for the dark half).
         The chrome sits over an arbitrary jet heatmap, so legibility comes from the
         puck fill + 1dp rim + a text halo — never from a solid plate.
         Light theme keeps a white-translucent frost with dark ink; night flips to the
         original #52FFFFFF-on-dark treatment. -->
    <color name="viewer_immersive_canvas">#0B1220</color>   <!-- unused: canvas stays theme-adaptive -->
    <color name="viewer_glass_fill">#B8FFFFFF</color>       <!-- ~72% white frost under dark ink -->
    <color name="viewer_glass_stroke">#33152430</color>     <!-- rim that defines the puck on a light canvas -->
    <color name="viewer_glass_pill">#8CFFFFFF</color>       <!-- ~55% white unchecked field pill -->
    <color name="viewer_glass_ripple">#1F152430</color>     <!-- dark ripple on a light frost -->

    <!-- Halo behind bare chrome text (no puck): keeps 13-18sp labels readable over
         both the light canvas and a saturated heatmap. Night inverts to a shadow. -->
    <color name="viewer_text_halo">#B3FFFFFF</color>

    <!-- bg_probe_chip is deliberately dark in BOTH themes (a dark puck reads over any
         jet colour), so its ink and rim stay light in both — no night override. Used
         by the probe readout and the summary progress card. -->
    <color name="viewer_probe_ink">#FFFFFFFF</color>
    <color name="viewer_probe_stroke">#73FFFFFF</color>

    <!-- Selected field pill. The idiom is inversion: the checked pill flips to the
         opposite polarity of the unchecked frost, so selection reads at a glance.
         Light = dark fill / white ink; night = white fill / near-black ink (19e5209).
         The UNCHECKED ink is viewer_chrome_text, which already flips per theme —
         a fixed white would vanish on the light theme's white frost. -->
    <color name="viewer_pill_on_bg">#E6152430</color>
    <color name="viewer_pill_on_text">#FFFFFFFF</color>

    <color name="viewer_peek_scrim">#FFFFFFFF</color>       <!-- peek sheet surface -->
    <color name="viewer_peek_divider">#1F152430</color>
    <color name="viewer_peek_handle">#40152430</color>
    <color name="viewer_peek_text">#152430</color>
    <color name="viewer_peek_muted">#5B6B7A</color>
    <color name="viewer_peek_accent">#0288D1</color>

    <!-- Dark mode is force-dark (render-time inversion of this palette), which
         never touches window/system-bar colors — these two aliases carry the
         night variant instead (see values-night/colors.xml). -->
    <color name="bar_system">@color/surface_muted</color>
    <color name="splash_bg">@color/surface_muted</color>

    <!-- Brand plate behind the S / wordmark: sky in light, black in night. -->
    <color name="brand_plate">@color/sky_primary</color>

    <color name="viewer_chrome_text">@color/text_primary</color>
    <color name="viewer_chrome_muted">@color/text_secondary</color>

    <color name="toast_crisp_bg">#E61A1A1A</color>
    <!-- Near-opaque for instructional toasts (e.g. reference picker gate). -->
    <color name="toast_crisp_prominent_bg">#F51A1A1A</color>
    <color name="toast_crisp_text">#FFFFFFFF</color>

    <!-- VsgPlotView / VsgLatticeView: shared by the result lattice, the wizard's
         sweep preview, and the immersive viewer's peek-sheet line-cut, so these
         cannot be the light-locked text_*/surface_outline/sky_* tokens the two
         views used to read directly: that left the peek sheet's dark glass line-
         cut plot always rendering in light-mode ink. Light values below equal
         today's literal colours (sky_primary, text_secondary, etc.), so light
         mode is pixel-identical; only night is new. -->
    <color name="viewer_plot_grid">@color/surface_outline</color>
    <color name="viewer_plot_ink">@color/text_secondary</color>
    <color name="viewer_plot_ink_strong">@color/text_primary</color>
    <!-- Emphasis mode (dataviz skill): non-focused curves share one desaturated
         neutral instead of their own hue, so only the focused curve carries
         colour meaning, so the categorical palette below no longer needs to
         separate 8 simultaneous hues, only ever one against this neutral. -->
    <color name="viewer_plot_muted">#9FB0BC</color>
    <color name="viewer_plot_node_solved">@color/sky_primary</color>
    <color name="viewer_plot_node_skipped">@color/semantic_danger</color>
    <color name="viewer_plot_connector">@color/sky_container</color>

    <!-- 8-slot categorical palette for the lattice curves (VsgPlotView.paletteColor,
         keyed by solved-frame index). Under emphasis only one slot is ever shown
         in colour at a time (the focused curve; every other curve renders in
         viewer_plot_muted; see the dataviz skill's anti-patterns.md on "8
         categorical hues when the story is one"), so each slot is validated
         per-slot with scripts/validate_palette.js (lightness band, chroma floor,
         contrast vs surface), not for pairwise separation. Night overrides only
         slot 7: every other slot already clears the dark-surface checks
         unchanged, so this array is otherwise identical in both themes. -->
    <color name="viewer_plot_palette_0">#0288D1</color>
    <color name="viewer_plot_palette_1">#E53935</color>
    <color name="viewer_plot_palette_2">#43A047</color>
    <color name="viewer_plot_palette_3">#B15C00</color>
    <color name="viewer_plot_palette_4">#8E24AA</color>
    <color name="viewer_plot_palette_5">#00897B</color>
    <color name="viewer_plot_palette_6">#A6462D</color>
    <color name="viewer_plot_palette_7">#3949AB</color>

    <!-- Line-cut (exx/eyy/exy): always 3 concurrent curves, so this IS validated
         all-pairs (scripts/validate_palette.js, pairs=all): worst pair ΔE 10.7
         deutan / 24.7 normal against surface #F4F9FC. Deliberately not slots
         0/1/2 of viewer_plot_palette above: that triad's green sits at deutan
         ΔE 2.9 from red; this substitutes slot 4's purple for green. -->
    <color name="viewer_line_cut_0">#0288D1</color>
    <color name="viewer_line_cut_1">#E53935</color>
    <color name="viewer_line_cut_2">#8E24AA</color>
</resources>
