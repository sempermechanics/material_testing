<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Spacing scale. New and reworked layouts take their margins and padding
        from here instead of inline dp; older screens move over when they are
        next reworked, not in a sweep. Add a step only when a layout uses it.
    -->
    <!-- The smallest tap target on any screen (readiness AE1-102). -->
    <dimen name="min_touch_target">48dp</dimen>
    <dimen name="space_4">4dp</dimen>
    <dimen name="space_8">8dp</dimen>
    <dimen name="space_12">12dp</dimen>
    <dimen name="space_16">16dp</dimen>
    <dimen name="space_24">24dp</dimen>

    <!-- Type scale (TextAppearance.Semper.*). New and reworked text takes its size
         from here; no layout text goes below the caption (readiness AE1-011). -->
    <dimen name="text_title">20sp</dimen>
    <dimen name="text_subtitle">16sp</dimen>
    <dimen name="text_body">14sp</dimen>
    <dimen name="text_label">13sp</dimen>
    <dimen name="text_caption">12sp</dimen>

    <!-- Side inset of the main screens' content column (Home's list, Settings,
         sign-in, the wizard pages): 0 on a phone; values-w600dp / w840dp / w1240dp
         raise it so a tablet shows a column near 600 dp instead of a stretched
         phone layout (readiness AE1-019). The viewer stays full-bleed. -->
    <dimen name="content_side_inset">0dp</dimen>
    <!-- A bottom action bar's side padding: its own 12dp plus content_side_inset,
         so its buttons line up with the column on a tablet (readiness AE1-115). -->
    <dimen name="bar_side_padding">12dp</dimen>

    <!-- Home row thumbnail edge; its result render is cached at twice this in px (SessionThumbs). -->
    <dimen name="session_thumb_size">44dp</dimen>
    <!-- Sweep page: the line-cut preview as a strip, and opened. -->
    <dimen name="line_cut_preview_strip">96dp</dimen>
    <dimen name="line_cut_preview_open_min">240dp</dimen>
</resources>
