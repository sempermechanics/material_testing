<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_semper_launcher_background">@color/ic_semper_launcher_background_light</color>
    <!-- The two launcher entries (LauncherIcon): light by day, jet black at night. -->
    <color name="ic_semper_launcher_background_light">#F4F9FC</color>
    <color name="ic_semper_launcher_background_dark">#000000</color>
    <!-- Before API 26 there are no adaptive icons: both entries use the legacy one. -->
    <item name="ic_semper_launcher_light" type="mipmap">@mipmap/ic_semper_launcher</item>
    <item name="ic_semper_launcher_dark" type="mipmap">@mipmap/ic_semper_launcher</item>
</resources>
