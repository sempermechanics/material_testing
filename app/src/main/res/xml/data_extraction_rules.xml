<?xml version="1.0" encoding="utf-8"?><!--
   Backup/transfer rules for API 31+. Kept in sync with backup_rules.xml
   (which covers API 30 and below).

   Excluded and why:
   - sharedpref: holds the backend session (Google ID token) and the device
     id — device-bound credentials that must never leave the device via backup
     or transfer. (The device private key lives in the Android Keystore.)
   - files/sessions: the local session index plus per-session frames and
     reference images. Bulky (cloud backup caps at 25 MB) and already
     recoverable through cloud sync for synced sessions.

   After a restore the user signs in again and starts with an empty local
   list — synced artifacts remain available in the cloud (Google Drive).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="sessions" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="sessions" />
    </device-transfer>
</data-extraction-rules>