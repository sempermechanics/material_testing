<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for API 30 and below (API 31+ uses
   data_extraction_rules.xml). Kept in sync with that file.

   Excluded and why:
   - sharedpref: holds the backend session (Google ID token) and the device
     id — device-bound credentials that must never leave the device via backup.
     (The device private key lives in the Android Keystore, not here.)
   - files/sessions: the local session index plus per-session frames and
     reference images. Bulky (Auto Backup caps at 25 MB) and already
     recoverable through cloud sync for synced sessions.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="sessions" />
</full-backup-content>