<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ScopedStorage,SelectedPhotoAccess">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"
        tools:ignore="SelectedPhotoAccess" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"
        tools:ignore="SelectedPhotoAccess" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
    </queries>
    <application
        android:name=".SemperApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_semper_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_semper_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Semper"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Diagnostics collection is OFF until the user opts in. Both SDKs
             otherwise start collecting on first launch, before any notice is
             shown — SemperApp re-enables them at startup when the user has
             agreed (DicSettings.diagnosticsEnabled). These flags are the
             build-time default, not the runtime state. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />

        <!-- Credential Manager: tells password managers which domain's
             credentials belong to this app, via the same Digital Asset
             Links file the sign-in App Link already verifies against. -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Semper.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <!-- Firebase passwordless email-link sign-in returns to the app here as
                 an App Link. Host + path must match EMAIL_LINK_CONTINUE_URL in
                 AuthRepository. autoVerify needs a Digital Asset Links file served
                 at the host (see docs/backend/AUTH_SETUP.md). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="indicvision-dic-app-auth.firebaseapp.com"
                    android:path="/finishSignIn" />
            </intent-filter>
            <!-- Password-reset App Link. Host + path must match RESET_CONTINUE_URL
                 in AuthRepository. Firebase Console must set this as the password-
                 reset custom action URL. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="indicvision-dic-app-auth.firebaseapp.com"
                    android:path="/finishReset" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.home.HomeActivity" android:exported="false" />
        <activity
            android:name=".ui.capture.CaptureSetupActivity"
            android:exported="false" />
        <activity
            android:name=".ui.capture.CaptureSessionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            tools:ignore="LockedOrientationActivity,DiscouragedApi" />
        <activity android:name=".ui.admin.AdminActivity" android:exported="false" />
        <activity android:name=".ui.settings.SettingsActivity" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
        <activity android:name=".ui.auth.PendingApprovalActivity" android:exported="false" />
        <activity
            android:name=".ui.limit.SessionLimitActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".ui.limit.SeatRequiredActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity android:name=".ui.viewer.ResultViewerActivity" />

        <activity
            android:name=".ui.viewer.SaveExportActivity"
            android:exported="false"
            android:icon="@drawable/ic_folder"
            android:label="@string/share_save_to_files"
            android:theme="@style/Theme.Semper.Transparent" />

        <!-- A solve runs for minutes and onDestroy cancels it, so this screen has to
             absorb every config change rather than be recreated. uiMode covers the
             night-mode toggle, which is the one users actually hit mid-run. -->
        <activity
            android:name=".ui.analysis.StaticAnalysisActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|fontScale|density|locale|layoutDirection" />

        <activity
            android:name=".ui.analysis.RoiDrawActivity"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".ui.analysis.VsgLatticeActivity"
            android:exported="false" />

        <!--
            WorkManager declares SystemForegroundService without a
            foregroundServiceType, which Android 14+ rejects outright
            ("Starting FGS with type none … has been prohibited"). Merge the
            dataSync type onto its declaration; the type passed to
            ForegroundInfo in TransferNotifications must stay a subset of this.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

    </application>
</manifest>