<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ScopedStorage,SelectedPhotoAccess">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"
        tools:ignore="SelectedPhotoAccess" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"
        tools:ignore="SelectedPhotoAccess" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- No ads and no ad SDKs: Firebase Analytics (play-services-measurement)
         merges in the advertising-ID and Privacy Sandbox permissions, so they
         are removed here, and google_analytics_adid_collection_enabled below
         keeps the SDK from reading the ID. The Play Data safety answers
         (docs/legal/PLAY_DATA_SAFETY.md) and Play's advertising-ID declaration
         rely on both (TD-232). -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <application
        android:name=".SemperApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_semper_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_semper_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Semper"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Diagnostics collection is OFF until the user opts in. Both SDKs
             otherwise start collecting on first launch, before any notice is
             shown — SemperApp re-enables them at startup when the user has
             agreed (AppSettings.diagnosticsEnabled). These flags are the
             build-time default, not the runtime state. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <!-- Never the advertising ID, consent or not (TD-232; the permission
             is removed above). -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <!-- Credential Manager: tells password managers which domain's
             credentials belong to this app, via the same Digital Asset
             Links file the sign-in App Link already verifies against. -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!-- Managed configuration for device management (EMM): the keys an
             organisation can set for this app. Read by ManagedConfigReader. -->
        <meta-data
            android:name="android.content.APP_RESTRICTIONS"
            android:resource="@xml/app_restrictions" />

        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Semper.Splash" />

        <!-- Two launcher entries for SplashActivity: the light icon and the
             jet-black one. Launchers never swap an icon's -night resources on a
             dark-mode change, so LauncherIcon enables the entry that matches
             the system theme and disables the other. -->
        <activity-alias
            android:name=".LauncherLight"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_semper_launcher_light"
            android:roundIcon="@mipmap/ic_semper_launcher_light"
            android:targetActivity=".ui.auth.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_semper_launcher_dark"
            android:roundIcon="@mipmap/ic_semper_launcher_dark"
            android:targetActivity=".ui.auth.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <!-- Firebase passwordless email-link sign-in returns to the app here as
                 an App Link. Host + path must match EMAIL_LINK_CONTINUE_URL in
                 AuthRepository (AUTH_HOST). autoVerify needs a Digital Asset Links
                 file served at the host (see docs/backend/AUTH_SETUP.md). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="app.sempermechanics.com"
                    android:path="/auth/finishSignIn" />
            </intent-filter>
            <!-- Password-reset App Link. Host + path must match RESET_CONTINUE_URL
                 in AuthRepository. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="app.sempermechanics.com"
                    android:path="/auth/finishReset" />
            </intent-filter>
            <!-- The same two links on the Hosting site's own domain
                 (LEGACY_AUTH_HOST). The password-reset custom action URL in
                 Firebase Console still points here, because every build before
                 AUTH_HOST declares only this host; both filters stay until no
                 such build is installed (TD-29). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="indicvision-dic-app-auth.firebaseapp.com"
                    android:path="/finishSignIn" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="indicvision-dic-app-auth.firebaseapp.com"
                    android:path="/finishReset" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.home.HomeActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminActivity" android:exported="false" />
        <activity android:name=".ui.settings.SettingsActivity" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
        <activity android:name=".ui.auth.PendingApprovalActivity" android:exported="false" />
        <activity android:name=".ui.auth.TermsActivity" android:exported="false" />
        <activity
            android:name=".ui.limit.SessionLimitActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".ui.limit.SeatRequiredActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".ui.limit.UpdateRequiredActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <!-- Screens with text fields say adjustResize (here, the wizard and the ROI
             editor). Before Android 15 the window then shrinks above the keyboard;
             from 15 the app is edge-to-edge and nothing resizes, so the Insets IME
             helpers pad or lift the views instead. Left to the default, these
             windows ran in pan mode: views got no keyboard inset, and a field low
             on the screen could not be scrolled above the keyboard. -->
        <activity
            android:name=".ui.viewer.ResultViewerActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.viewer.SaveExportActivity"
            android:exported="false"
            android:icon="@drawable/ic_folder"
            android:label="@string/share_save_to_files"
            android:theme="@style/Theme.Semper.Transparent" />

        <!-- A solve runs for minutes and onDestroy cancels it, so this screen has to
             absorb every config change rather than be recreated. uiMode covers the
             night-mode toggle, which is the one users actually hit mid-run. -->
        <activity
            android:name=".ui.analysis.StaticAnalysisActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|fontScale|density|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.analysis.RoiDrawActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.analysis.VsgLatticeActivity"
            android:exported="false" />

        <!--
            WorkManager declares SystemForegroundService without a
            foregroundServiceType, which Android 14+ rejects outright
            ("Starting FGS with type none … has been prohibited"). Merge the
            dataSync type onto its declaration; the type passed to
            ForegroundInfo in TransferNotifications must stay a subset of this.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Retry on a failed backup / restore notification; only our own explicit PendingIntents reach it. -->
        <receiver
            android:name=".data.cloud.TransferRetryReceiver"
            android:exported="false" />

    </application>
</manifest>