{
  "hosting": {
    "site": "indicvision-dic-app-auth",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "appAssociation": "AUTO",
    "rewrites": [
      {
        "source": "/finishSignIn",
        "destination": "/finishSignIn/index.html"
      },
      {
        "source": "/finishReset",
        "destination": "/finishReset/index.html"
      }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      }
    ]
  }
}
