{
  "bindings": [
    {
      "role": "roles/owner",
      "members": [
        "group:owners@example.test",
        "group:breakglass@example.test"
      ]
    },
    {
      "role": "roles/firebaseauth.admin",
      "members": [
        "serviceAccount:api@demo-app-prod.iam.gserviceaccount.com"
      ]
    }
  ],
  "auditConfigs": [
    {
      "service": "allServices",
      "auditLogConfigs": [
