{
  "displayName": "semper: __SERVICE__ p95 latency above 2 s for 15 min",
  "documentation": {
    "content": "The 95th percentile of __SERVICE__ request latency (Cloud Run request_latencies) stayed above 2 s for 15 minutes. With min-instances 0 a cold start is p95 ~6 s, so at very low traffic cold starts alone can hold this up. Runbook: ops/monitoring/README.md#latency-p95",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "p95 request latency > 2000 ms (15 min)",
      "conditionThreshold": {
        "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"__SERVICE__\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_PERCENTILE_95",
            "groupByFields": [
              "resource.label.service_name"
            ]
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 2000,
        "duration": "900s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "alertStrategy": {
    "autoClose": "86400s"
  },
  "severity": "WARNING",
  "notificationChannels": [
    "__NOTIFICATION_CHANNEL__"
  ],
  "userLabels": {
    "app": "semper",
    "managed_by": "ops-monitoring"
  }
}
