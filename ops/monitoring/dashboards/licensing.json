{
  "displayName": "semper-licensing",
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 48,
        "height": 5,
        "widget": {
          "text": {
            "content": "Licence key redemptions, floating-seat checkouts and device-lock drops on **__SERVICE__**, hourly, from the log-based metrics in `ops/monitoring/metrics/`. Split by outcome, refusal code, and the calling app and build (`X-App-Id`, `X-App-Version`). Never by licence: per-licence counts are the activation-anomaly alert's job. Runbook: `ops/monitoring/README.md#activation-anomaly`.",
            "format": "MARKDOWN"
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 5,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "Activations by outcome",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/semper_activation\" AND resource.type=\"cloud_run_revision\"",
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.outcome"
                      ]
                    }
                  }
                },
                "plotType": "STACKED_BAR",
                "minAlignmentPeriod": "3600s",
                "targetAxis": "Y1",
                "legendTemplate": "${metric.labels.outcome}"
              }
            ],
            "yAxis": {
              "label": "per hour",
              "scale": "LINEAR"
            },
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 24,
        "yPos": 5,
        "width": 24,
        "height": 16,
