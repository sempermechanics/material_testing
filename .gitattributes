# Normalize line endings: LF in the repository for everything text.
* text=auto eol=lf

# Windows scripts must stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# The gradle wrapper script must be LF + executable (see CI)
gradlew text eol=lf

# Binaries — never touch
*.jar binary
*.png binary
*.webp binary
*.jpg binary
*.jks binary
*.keystore binary
*.so binary
*.tiff binary
*.pdf binary
